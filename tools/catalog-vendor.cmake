# Options:
#   SOURCES      file written by CATALOG_RECORD_SOURCES (required)
#   VENDOR_DIR   directory to fill (default: catalog-vendor)
#   VERIFY       ON: only check that everything is there and matches, do not fetch (exit code 1 if not)
#   KEEP_GIT     OFF: remove the .git directories of checkouts after fetching them (default: ON)

cmake_minimum_required(VERSION 3.19)
include("${CMAKE_CURRENT_LIST_DIR}/internal/sources.cmake")

if(NOT DEFINED SOURCES)
  message(FATAL_ERROR "usage: cmake -DSOURCES=<recorded sources file> [-DVENDOR_DIR=<dir>] [-DVERIFY=ON] -P ${CMAKE_CURRENT_LIST_FILE}")
endif()
if(NOT DEFINED VENDOR_DIR)
  set(VENDOR_DIR "catalog-vendor")
endif()
if(NOT DEFINED KEEP_GIT)
  set(KEEP_GIT ON)
endif()
get_filename_component(VENDOR_DIR "${VENDOR_DIR}" ABSOLUTE)

cs_parse_sources("${SOURCES}")

set(MISSING 0)
set(FETCHED 0)
set(OK 0)

function(_git_head DIR OUT)
  set(HEAD "")
  if(EXISTS "${DIR}/.git")
    execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${DIR}"
      OUTPUT_VARIABLE HEAD RESULT_VARIABLE RES ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT RES EQUAL 0)
      set(HEAD "")
    endif()
  endif()
  set(${OUT} "${HEAD}" PARENT_SCOPE)
endfunction()

foreach(I RANGE ${CS_COUNT})
  if(I EQUAL CS_COUNT)
    break()
  endif()
  set(KIND "${CS_${I}_KIND}")
  set(URL "${CS_${I}_URL}")
  set(REF "${CS_${I}_REF}")
  set(CACHE_NAME "${CS_${I}_CACHE}")
  set(HASH "${CS_${I}_HASH}")
  cs_is_git("${KIND}" IS_GIT)
  cs_entry_subdir("${KIND}" SUBDIR)
  set(TARGET_DIR "${VENDOR_DIR}")
  if(NOT SUBDIR STREQUAL "")
    set(TARGET_DIR "${VENDOR_DIR}/${SUBDIR}")
  endif()
  set(TARGET "${TARGET_DIR}/${CACHE_NAME}")

  if(IS_GIT)
    set(COMMIT "${HASH}")
    cs_is_commit("${REF}" REF_IS_COMMIT)
    if(COMMIT STREQUAL "" AND REF_IS_COMMIT)
      set(COMMIT "${REF}")
    endif()
    if(COMMIT STREQUAL "")
      message(WARNING "${URL} (${REF}): no commit recorded, cannot vendor it")
      math(EXPR MISSING "${MISSING} + 1")
      continue()
    endif()
    _git_head("${TARGET}" HEAD)
    if(HEAD STREQUAL COMMIT OR (EXISTS "${TARGET}" AND NOT EXISTS "${TARGET}/.git" AND NOT KEEP_GIT))
      math(EXPR OK "${OK} + 1")
      continue()
    endif()
    if(VERIFY)
      message(WARNING "missing or different: ${TARGET} (${URL} at ${COMMIT})")
      math(EXPR MISSING "${MISSING} + 1")
      continue()
    endif()
    message(STATUS "Cloning ${URL} at ${COMMIT}")
    file(REMOVE_RECURSE "${TARGET}")
    file(MAKE_DIRECTORY "${TARGET_DIR}")
    execute_process(COMMAND git clone --quiet "${URL}" "${TARGET}" RESULT_VARIABLE RES ERROR_VARIABLE ERR)
    if(RES EQUAL 0)
      execute_process(COMMAND git checkout --quiet "${COMMIT}" WORKING_DIRECTORY "${TARGET}" RESULT_VARIABLE RES ERROR_VARIABLE ERR)
    endif()
    if(NOT RES EQUAL 0)
      message(WARNING "failed to fetch ${URL} at ${COMMIT}: ${ERR}")
      math(EXPR MISSING "${MISSING} + 1")
      continue()
    endif()
    if(NOT KEEP_GIT)
      file(REMOVE_RECURSE "${TARGET}/.git")
    endif()
    math(EXPR FETCHED "${FETCHED} + 1")
  else()
    if(HASH STREQUAL "")
      message(WARNING "${URL}: no sha256 recorded, cannot vendor it")
      math(EXPR MISSING "${MISSING} + 1")
      continue()
    endif()
    if(EXISTS "${TARGET}")
      file(SHA256 "${TARGET}" CURRENT)
      if(CURRENT STREQUAL HASH)
        math(EXPR OK "${OK} + 1")
        continue()
      endif()
      if(VERIFY)
        message(WARNING "checksum mismatch: ${TARGET} (expected ${HASH}, got ${CURRENT})")
        math(EXPR MISSING "${MISSING} + 1")
        continue()
      endif()
    elseif(VERIFY)
      message(WARNING "missing: ${TARGET} (${URL})")
      math(EXPR MISSING "${MISSING} + 1")
      continue()
    endif()
    message(STATUS "Downloading ${URL}")
    file(MAKE_DIRECTORY "${TARGET_DIR}")
    file(DOWNLOAD "${URL}" "${TARGET}.tmp" EXPECTED_HASH SHA256=${HASH} STATUS DL_STATUS TIMEOUT 300 INACTIVITY_TIMEOUT 30)
    list(GET DL_STATUS 0 DL_CODE)
    if(NOT DL_CODE EQUAL 0)
      list(GET DL_STATUS 1 DL_ERR)
      file(REMOVE "${TARGET}.tmp")
      message(WARNING "failed to fetch ${URL}: ${DL_ERR}")
      math(EXPR MISSING "${MISSING} + 1")
      continue()
    endif()
    file(RENAME "${TARGET}.tmp" "${TARGET}")
    math(EXPR FETCHED "${FETCHED} + 1")
  endif()
endforeach()

if(VERIFY)
  message(STATUS "${OK} of ${CS_COUNT} entries are in place in ${VENDOR_DIR}")
else()
  message(STATUS "${VENDOR_DIR}: ${FETCHED} fetched, ${OK} already there")
endif()
if(MISSING GREATER 0)
  message(FATAL_ERROR "${MISSING} entries could not be vendored or verified")
endif()
