# Options:
#   SOURCES   file written by CATALOG_RECORD_SOURCES (required)
#   OUTPUT    file to write (default: catalog-sources.json)
#   DEST      directory of the module source tree that holds the sources, i.e. what
#             CATALOG_VENDOR_DIR points to (default: catalog-vendor)
#   STRICT    ON: fail instead of warning about sources that are not pinned
#   LAYOUT    cache (default): sources named after Catalog's cache, keyed by a hash of the URL and
#             ref. Changing a version or commit means generating again.
#             overrides: every dependency becomes a tree at <DEST>/<package>, to be used with
#             CATALOG_SOURCE_DIR_<package>. The generated file is only a starting point: the
#             manifest can change commits, tags and patches by hand without Catalog noticing.

cmake_minimum_required(VERSION 3.19)
include("${CMAKE_CURRENT_LIST_DIR}/internal/sources.cmake")

if(NOT DEFINED SOURCES)
  message(FATAL_ERROR "usage: cmake -DSOURCES=<recorded sources file> [-DOUTPUT=<file>] [-DDEST=<dir>] [-DSTRICT=ON] -P ${CMAKE_CURRENT_LIST_FILE}")
endif()
if(NOT DEFINED OUTPUT)
  set(OUTPUT "catalog-sources.json")
endif()
if(NOT DEFINED DEST)
  set(DEST "catalog-vendor")
endif()
if(NOT DEFINED LAYOUT)
  set(LAYOUT "cache")
endif()
if(NOT LAYOUT MATCHES "^(cache|overrides)$")
  message(FATAL_ERROR "LAYOUT must be cache or overrides")
endif()
set(OVERRIDE_FLAGS "")

function(_json_escape IN OUT)
  string(REPLACE "\\" "\\\\" S "${IN}")
  string(REPLACE "\"" "\\\"" S "${S}")
  set(${OUT} "${S}" PARENT_SCOPE)
endfunction()

cs_parse_sources("${SOURCES}")

set(OBJECTS "")
set(REPO_KEYS "")
set(REPO_REFS "")
set(PROBLEMS 0)
set(WARNINGS "")

foreach(I RANGE ${CS_COUNT})
  if(I EQUAL CS_COUNT)
    break()
  endif()
  set(KIND "${CS_${I}_KIND}")
  set(URL "${CS_${I}_URL}")
  set(REF "${CS_${I}_REF}")
  set(CACHE_NAME "${CS_${I}_CACHE}")
  set(HASH "${CS_${I}_HASH}")
  cs_is_git("${KIND}" IS_GIT)
  cs_entry_subdir("${KIND}" SUBDIR)
  set(ENTRY_DEST "${DEST}")
  if(NOT SUBDIR STREQUAL "")
    set(ENTRY_DEST "${DEST}/${SUBDIR}")
  endif()

  _json_escape("${URL}" J_URL)
  _json_escape("${ENTRY_DEST}" J_DEST)

  if(LAYOUT STREQUAL "overrides" AND (KIND STREQUAL "recipe" OR KIND STREQUAL "repofile")
     AND URL MATCHES "^https://raw\\.githubusercontent\\.com/([^/]+)/([^/]+)/([^/]+)/")
    set(GH_OWNER "${CMAKE_MATCH_1}")
    set(GH_REPO "${CMAKE_MATCH_2}")
    set(GH_REF "${CMAKE_MATCH_3}")
    list(FIND REPO_KEYS "${GH_OWNER}/${GH_REPO}" REPO_IDX)
    if(REPO_IDX EQUAL -1)
      list(APPEND REPO_KEYS "${GH_OWNER}/${GH_REPO}")
      list(APPEND REPO_REFS "${GH_REF}")
    endif()
    continue()
  endif()

  if(IS_GIT)
    set(COMMIT "${HASH}")
    cs_is_commit("${REF}" REF_IS_COMMIT)
    if(COMMIT STREQUAL "" AND REF_IS_COMMIT)
      set(COMMIT "${REF}")
    endif()
    if(COMMIT STREQUAL "")
      list(APPEND WARNINGS "${URL} (${REF}): no commit was recorded, so it is left out. Configure again with git available, or pin the ref to a full commit hash.")
      math(EXPR PROBLEMS "${PROBLEMS} + 1")
      continue()
    endif()
    set(TREE "${CACHE_NAME}")
    if(LAYOUT STREQUAL "overrides" AND KIND STREQUAL "git" AND NOT CS_${I}_NAME STREQUAL "")
      set(TREE "${CS_${I}_NAME}")
      list(LENGTH CS_${I}_NAMES NAME_COUNT)
      if(NAME_COUNT GREATER 1)
        get_filename_component(TREE "${URL}" NAME_WE)
      endif()
      foreach(PKG IN LISTS CS_${I}_NAMES)
        list(APPEND OVERRIDE_FLAGS "-DCATALOG_SOURCE_DIR_${PKG}=${DEST}/${TREE}")
      endforeach()
    endif()
    set(OBJ "  {\n    \"type\": \"git\",\n    \"url\": \"${J_URL}\",\n    \"commit\": \"${COMMIT}\",\n    \"dest\": \"${J_DEST}/${TREE}\"\n  }")
  elseif(LAYOUT STREQUAL "overrides" AND KIND STREQUAL "archive" AND NOT HASH STREQUAL "" AND NOT CS_${I}_NAME STREQUAL "")
    set(TREE "${CS_${I}_NAME}")
    foreach(PKG IN LISTS CS_${I}_NAMES)
      list(APPEND OVERRIDE_FLAGS "-DCATALOG_SOURCE_DIR_${PKG}=${DEST}/${TREE}")
    endforeach()
    set(OBJ "  {\n    \"type\": \"archive\",\n    \"url\": \"${J_URL}\",\n    \"sha256\": \"${HASH}\",\n    \"strip-components\": 1,\n    \"dest\": \"${J_DEST}/${TREE}\"\n  }")
  else()
    if(HASH STREQUAL "")
      list(APPEND WARNINGS "${URL}: no sha256 was recorded, so it is left out.")
      math(EXPR PROBLEMS "${PROBLEMS} + 1")
      continue()
    endif()
    cs_is_unpinned("${URL}" UNPINNED)
    if(UNPINNED)
      list(APPEND WARNINGS "${URL} is not pinned (it follows a branch or a moving tag). The build breaks when its content changes. Use a tag or a commit, or ship the file in the repository.")
      math(EXPR PROBLEMS "${PROBLEMS} + 1")
    endif()
    _json_escape("${CACHE_NAME}" J_NAME)
    set(OBJ "  {\n    \"type\": \"file\",\n    \"url\": \"${J_URL}\",\n    \"sha256\": \"${HASH}\",\n    \"dest\": \"${J_DEST}\",\n    \"dest-filename\": \"${J_NAME}\"\n  }")
  endif()
  list(APPEND OBJECTS "${OBJ}")
endforeach()

set(IDX 0)
foreach(KEY IN LISTS REPO_KEYS)
  list(GET REPO_REFS ${IDX} GH_REF)
  math(EXPR IDX "${IDX} + 1")
  string(REPLACE "/" ";" KEY_PARTS "${KEY}")
  list(GET KEY_PARTS 0 GH_OWNER)
  list(GET KEY_PARTS 1 GH_REPO)
  set(COMMIT "")
  cs_is_commit("${GH_REF}" REF_IS_COMMIT)
  if(REF_IS_COMMIT)
    set(COMMIT "${GH_REF}")
  else()
    execute_process(COMMAND git ls-remote "https://github.com/${GH_OWNER}/${GH_REPO}.git" "${GH_REF}"
      OUTPUT_VARIABLE LS_OUT RESULT_VARIABLE LS_RES ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(LS_RES EQUAL 0)
      string(REGEX MATCH "^[0-9a-f]+" LS_HASH "${LS_OUT}")
      cs_is_commit("${LS_HASH}" LS_IS_COMMIT)
      if(LS_IS_COMMIT)
        set(COMMIT "${LS_HASH}")
      endif()
    endif()
  endif()
  if(COMMIT STREQUAL "")
    list(APPEND WARNINGS "Could not resolve ${GH_REF} of ${GH_OWNER}/${GH_REPO} to a commit, so the recipes of that repository are left out.")
    math(EXPR PROBLEMS "${PROBLEMS} + 1")
    continue()
  endif()
  set(REPO_SUFFIX "${GH_OWNER}_${GH_REPO}")
  string(REGEX REPLACE "[^A-Za-z0-9_]" "_" REPO_SUFFIX "${REPO_SUFFIX}")
  _json_escape("${DEST}" J_DEST)
  set(OBJ "  {\n    \"type\": \"git\",\n    \"url\": \"https://github.com/${GH_OWNER}/${GH_REPO}.git\",\n    \"commit\": \"${COMMIT}\",\n    \"dest\": \"${J_DEST}/recipe-repos/${GH_OWNER}_${GH_REPO}\"\n  }")
  list(APPEND OBJECTS "${OBJ}")
  list(APPEND OVERRIDE_FLAGS "-DCATALOG_REPO_OVERRIDE_${REPO_SUFFIX}=${DEST}/recipe-repos/${GH_OWNER}_${GH_REPO}")
endforeach()

list(LENGTH OBJECTS OBJECT_COUNT)
set(JSON "[\n")
set(FIRST TRUE)
foreach(OBJ IN LISTS OBJECTS)
  if(NOT FIRST)
    string(APPEND JSON ",\n")
  endif()
  set(FIRST FALSE)
  string(APPEND JSON "${OBJ}")
endforeach()
string(APPEND JSON "\n]\n")
file(WRITE "${OUTPUT}" "${JSON}")

foreach(W IN LISTS WARNINGS)
  message(WARNING "${W}")
endforeach()
message(STATUS "Wrote ${OBJECT_COUNT} flatpak-builder sources to ${OUTPUT}")
if(LAYOUT STREQUAL "overrides")
  string(REPLACE ";" " " FLAGS_TEXT "${OVERRIDE_FLAGS}")
  message(STATUS "Source trees are placed in '${DEST}/<package>'. Build with: -DCATALOG_OFFLINE=ON ${FLAGS_TEXT}")
  message(STATUS "(use paths relative to the top level source dir, or absolute ones)")
else()
  message(STATUS "They are placed in '${DEST}': build with -DCATALOG_OFFLINE=ON -DCATALOG_VENDOR_DIR=${DEST}")
endif()
if(STRICT AND PROBLEMS GREATER 0)
  message(FATAL_ERROR "${PROBLEMS} problem(s) found (STRICT is on)")
endif()
