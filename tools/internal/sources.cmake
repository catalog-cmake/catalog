macro(cs_parse_sources _CS_FILE)
  if(NOT EXISTS "${_CS_FILE}")
    message(FATAL_ERROR "Sources file not found: ${_CS_FILE}\n(configure the project once with CATALOG_RECORD_SOURCES=<file> to create it)")
  endif()
  file(STRINGS "${_CS_FILE}" _CS_LINES)
  set(_CS_KEYS "")
  set(CS_COUNT 0)
  foreach(_CS_LINE IN LISTS _CS_LINES)
    if(NOT "${_CS_LINE}" STREQUAL "")
      string(REPLACE "\t" ";" _CS_F "${_CS_LINE}")
      list(LENGTH _CS_F _CS_N)
      if(NOT _CS_N EQUAL 6)
        message(WARNING "Skipping malformed line: ${_CS_LINE}")
      else()
        list(GET _CS_F 0 _CS_KIND)
        list(GET _CS_F 1 _CS_NAME)
        list(GET _CS_F 2 _CS_URL)
        list(GET _CS_F 3 _CS_REF)
        list(GET _CS_F 4 _CS_CACHE)
        list(GET _CS_F 5 _CS_HASH)
        foreach(_CS_V _CS_NAME _CS_REF _CS_HASH)
          if("${${_CS_V}}" STREQUAL "-")
            set(${_CS_V} "")
          endif()
        endforeach()
        list(FIND _CS_KEYS "${_CS_KIND}|${_CS_CACHE}" _CS_IDX)
        if(_CS_IDX EQUAL -1)
          list(APPEND _CS_KEYS "${_CS_KIND}|${_CS_CACHE}")
          set(_CS_IDX ${CS_COUNT})
          set(CS_${_CS_IDX}_NAMES "")
          math(EXPR CS_COUNT "${CS_COUNT} + 1")
        endif()
        if(NOT "${_CS_NAME}" STREQUAL "")
          list(FIND CS_${_CS_IDX}_NAMES "${_CS_NAME}" _CS_NIDX)
          if(_CS_NIDX EQUAL -1)
            list(APPEND CS_${_CS_IDX}_NAMES "${_CS_NAME}")
          endif()
        endif()
        set(CS_${_CS_IDX}_KIND "${_CS_KIND}")
        list(LENGTH CS_${_CS_IDX}_NAMES _CS_NLEN)
        if(_CS_NLEN GREATER 0)
          list(GET CS_${_CS_IDX}_NAMES 0 CS_${_CS_IDX}_NAME)
        endif()
        set(CS_${_CS_IDX}_URL "${_CS_URL}")
        set(CS_${_CS_IDX}_REF "${_CS_REF}")
        set(CS_${_CS_IDX}_CACHE "${_CS_CACHE}")
        set(CS_${_CS_IDX}_HASH "${_CS_HASH}")
      endif()
    endif()
  endforeach()
endmacro()

function(cs_entry_subdir KIND OUT)
  if(KIND STREQUAL "bootstrap")
    set(${OUT} "bootstrap" PARENT_SCOPE)
  else()
    set(${OUT} "" PARENT_SCOPE)
  endif()
endfunction()

function(cs_is_git KIND OUT)
  if(KIND STREQUAL "git" OR KIND STREQUAL "recipegit")
    set(${OUT} TRUE PARENT_SCOPE)
  else()
    set(${OUT} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(cs_is_unpinned URL OUT)
  if(URL MATCHES "/(HEAD|nightly|latest|main|master)/" OR URL MATCHES "/refs/heads/")
    set(${OUT} TRUE PARENT_SCOPE)
  else()
    set(${OUT} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(cs_is_commit STR OUT)
  string(LENGTH "${STR}" LEN)
  if(LEN EQUAL 40 AND STR MATCHES "^[0-9a-f]+$")
    set(${OUT} TRUE PARENT_SCOPE)
  else()
    set(${OUT} FALSE PARENT_SCOPE)
  endif()
endfunction()
