set(_CATALOG_REPOS "" CACHE INTERNAL "Loaded repositories")
set(_CATALOG_DIRECT_RECIPES "" CACHE INTERNAL "Direct recipe paths")
set(_CATALOG_ALL_RECIPES "" CACHE INTERNAL "All registered recipes")
set(_CATALOG_CONVENTION_RECIPES "" CACHE INTERNAL "Direct recipes that may have recipe-lib.cmake / recipe-exe.cmake next to them")

function(_catalog_load_repo_meta REPO_SOURCE)
  _catalog_resolve_repo_url(${REPO_SOURCE} RESOLVED_URL REPO_TYPE REPO_BASE REPO_NAME)
  _catalog_log_verbose("Loading repository ${REPO_NAME} (${REPO_TYPE}) from ${RESOLVED_URL}")
  
  _catalog_load_recipe(${RESOLVED_URL} REPO_FILE)
  
  unset(CATALOG_RECIPES)
  unset(CL_RECIPES)
  unset(CATALOG_DESCRIPTIONS)
  unset(CL_DESCRIPTIONS)
  include(${REPO_FILE})

  _catalog_get_var("DESCRIPTIONS" CATALOG_DESCRIPTIONS_VAL)
  foreach(DESCRIPTION ${CATALOG_DESCRIPTIONS_VAL})
    if(DESCRIPTION MATCHES "^([^:]+):(.*)$")
      set_property(GLOBAL PROPERTY "_CATALOG_DESCRIPTION_${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}")
    endif()
  endforeach()
  
  _catalog_get_var("RECIPES" CATALOG_RECIPES_VAL)
  if("${CATALOG_RECIPES_VAL}" STREQUAL "")
    _catalog_log(FATAL_ERROR "Repository meta.cmake did not define CATALOG_RECIPES")
  endif()
  
  if(REPO_TYPE STREQUAL "local")
    _catalog_set_var("REPO_DIR" "${REPO_BASE}")
  else()
    _catalog_set_var("REPO_DIR" "")
  endif()
  _catalog_set_var("REPO_NAME" "${REPO_NAME}")
  _catalog_set_var("REPO_TYPE" "${REPO_TYPE}")
  
  set(NEW_RECIPES "")
  foreach(RECIPE ${CATALOG_RECIPES_VAL})
    if(RECIPE MATCHES "^([^:]+):(.+)$")
      set(RECIPE_NAME "${CMAKE_MATCH_1}")
      set(RECIPE_PATH "${CMAKE_MATCH_2}")
      
      if(RECIPE_PATH MATCHES "^https?://" OR RECIPE_PATH MATCHES "^/")
        set(RESOLVED_RECIPE "${RECIPE_PATH}")
      else()
        set(RESOLVED_RECIPE "${REPO_BASE}/${RECIPE_PATH}")
      endif()
      
      list(APPEND NEW_RECIPES "${RECIPE_NAME}:${RESOLVED_RECIPE}")
      set_property(GLOBAL PROPERTY "_CATALOG_REPO_BASE_${RECIPE_NAME}" "${REPO_BASE}")
      set_property(GLOBAL PROPERTY "_CATALOG_REPO_URL_${RECIPE_NAME}" "${RESOLVED_URL}")
    endif()
  endforeach()
  
  set(_CATALOG_ALL_RECIPES "${_CATALOG_ALL_RECIPES};${NEW_RECIPES}" CACHE INTERNAL "All registered recipes")
  _catalog_set_var("RECIPES" "${CATALOG_RECIPES_VAL}")
  
  list(APPEND _CATALOG_REPOS "${RESOLVED_URL}")
  set(_CATALOG_REPOS "${_CATALOG_REPOS}" CACHE INTERNAL "Loaded repositories")
endfunction()

function(_catalog_add_recipe PACKAGE_NAME RECIPE_SOURCE)
  set(KIND "")
  if(ARGC GREATER 2)
    string(TOLOWER "${ARGV2}" KIND)
  endif()
  if(NOT KIND MATCHES "^(lib|exe)?$")
    _catalog_log(FATAL_ERROR "Invalid recipe kind '${ARGV2}' for ${PACKAGE_NAME} (expected LIB or EXE)")
  endif()

  _catalog_resolve_recipe_url(${RECIPE_SOURCE} RESOLVED_URL)
  set(KEY "${PACKAGE_NAME}")
  if(NOT KIND STREQUAL "")
    set(KEY "${PACKAGE_NAME}/${KIND}")
  endif()
  list(APPEND _CATALOG_DIRECT_RECIPES "${KEY}:${RESOLVED_URL}")
  set(_CATALOG_DIRECT_RECIPES "${_CATALOG_DIRECT_RECIPES}" CACHE INTERNAL "Direct recipe paths")

  if(RESOLVED_URL MATCHES "^(.*)/[^/]+$")
    set_property(GLOBAL PROPERTY "_CATALOG_REPO_BASE_${KEY}" "${CMAKE_MATCH_1}")
  endif()

  if(KIND STREQUAL "" AND RESOLVED_URL MATCHES "^(.*)/recipe\\.cmake$")
    set(RECIPE_DIR "${CMAKE_MATCH_1}")
    list(APPEND _CATALOG_CONVENTION_RECIPES "${PACKAGE_NAME}:${RECIPE_DIR}")
    set(_CATALOG_CONVENTION_RECIPES "${_CATALOG_CONVENTION_RECIPES}" CACHE INTERNAL "Direct recipes that may have recipe-lib.cmake / recipe-exe.cmake next to them")
    set_property(GLOBAL PROPERTY "_CATALOG_REPO_BASE_${PACKAGE_NAME}/lib" "${RECIPE_DIR}")
    set_property(GLOBAL PROPERTY "_CATALOG_REPO_BASE_${PACKAGE_NAME}/exe" "${RECIPE_DIR}")
  endif()
endfunction()

function(_catalog_canonical_package_name PACKAGE_NAME RESULT_VAR)
  string(TOLOWER "${PACKAGE_NAME}" WANTED)
  set(CANDIDATES "")
  foreach(RECIPE_LIST _CATALOG_DIRECT_RECIPES _CATALOG_ALL_RECIPES)
    foreach(RECIPE ${${RECIPE_LIST}})
      string(FIND "${RECIPE}" ":" COLON)
      if(COLON GREATER 0)
        string(SUBSTRING "${RECIPE}" 0 ${COLON} REGISTERED)
        string(REGEX REPLACE "/(lib|exe)$" "" REGISTERED "${REGISTERED}")
        if(REGISTERED STREQUAL PACKAGE_NAME)
          set(${RESULT_VAR} "${PACKAGE_NAME}" PARENT_SCOPE)
          return()
        endif()
        string(TOLOWER "${REGISTERED}" REGISTERED_LOWER)
        if(REGISTERED_LOWER STREQUAL WANTED)
          list(APPEND CANDIDATES "${REGISTERED}")
        endif()
      endif()
    endforeach()
  endforeach()

  list(REMOVE_DUPLICATES CANDIDATES)
  list(LENGTH CANDIDATES COUNT)
  if(COUNT EQUAL 1)
    list(GET CANDIDATES 0 REGISTERED)
    _catalog_log(STATUS "${PACKAGE_NAME}: using the recipe registered as '${REGISTERED}'")
    set(${RESULT_VAR} "${REGISTERED}" PARENT_SCOPE)
  elseif(COUNT GREATER 1)
    string(REPLACE ";" ", " NAMES "${CANDIDATES}")
    _catalog_log(FATAL_ERROR "Package name '${PACKAGE_NAME}' is ambiguous: it matches ${NAMES} (use the exact spelling)")
  else()
    set(${RESULT_VAR} "${PACKAGE_NAME}" PARENT_SCOPE)
  endif()
endfunction()

function(_catalog_list_lookup LIST_VAR KEY RESULT_VAR)
  set(ITEMS "${${LIST_VAR}}")
  if(ITEMS)
    list(REVERSE ITEMS)
  endif()
  string(LENGTH "${KEY}:" PREFIX_LEN)
  foreach(ITEM ${ITEMS})
    string(FIND "${ITEM}" "${KEY}:" POS)
    if(POS EQUAL 0)
      string(SUBSTRING "${ITEM}" ${PREFIX_LEN} -1 VALUE)
      set(${RESULT_VAR} "${VALUE}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${RESULT_VAR} "" PARENT_SCOPE)
endfunction()

function(_catalog_recipe_origin_of RECIPE_LIST KEY RESULT_VAR)
  if(RECIPE_LIST STREQUAL "_CATALOG_DIRECT_RECIPES")
    set(${RESULT_VAR} "direct" PARENT_SCOPE)
  else()
    get_property(REPO_URL GLOBAL PROPERTY "_CATALOG_REPO_URL_${KEY}")
    set(${RESULT_VAR} "${REPO_URL}" PARENT_SCOPE)
  endif()
endfunction()

function(_catalog_locate_recipe PACKAGE_NAME KIND PATH_VAR KEY_VAR SPECIFICITY_VAR ORIGIN_VAR)
  foreach(RECIPE_LIST _CATALOG_DIRECT_RECIPES _CATALOG_ALL_RECIPES)
    _catalog_list_lookup(${RECIPE_LIST} "${PACKAGE_NAME}/${KIND}" FOUND)
    if(NOT "${FOUND}" STREQUAL "")
      set(${PATH_VAR} "${FOUND}" PARENT_SCOPE)
      set(${KEY_VAR} "${PACKAGE_NAME}/${KIND}" PARENT_SCOPE)
      set(${SPECIFICITY_VAR} "specific" PARENT_SCOPE)
      _catalog_recipe_origin_of(${RECIPE_LIST} "${PACKAGE_NAME}/${KIND}" ORIGIN)
      set(${ORIGIN_VAR} "${ORIGIN}" PARENT_SCOPE)
      return()
    endif()

    _catalog_list_lookup(${RECIPE_LIST} "${PACKAGE_NAME}" FOUND)
    if(NOT "${FOUND}" STREQUAL "")
      if(RECIPE_LIST STREQUAL "_CATALOG_DIRECT_RECIPES")
        _catalog_list_lookup(_CATALOG_CONVENTION_RECIPES "${PACKAGE_NAME}" RECIPE_DIR)
        if(NOT "${RECIPE_DIR}" STREQUAL "")
          _catalog_recipe_available("${RECIPE_DIR}/recipe-${KIND}.cmake" HAS_VARIANT "${PACKAGE_NAME}")
          if(HAS_VARIANT)
            set(${PATH_VAR} "${RECIPE_DIR}/recipe-${KIND}.cmake" PARENT_SCOPE)
            set(${KEY_VAR} "${PACKAGE_NAME}/${KIND}" PARENT_SCOPE)
            set(${SPECIFICITY_VAR} "specific" PARENT_SCOPE)
            set(${ORIGIN_VAR} "direct" PARENT_SCOPE)
            return()
          endif()
          _catalog_recipe_available("${FOUND}" HAS_GENERIC "${PACKAGE_NAME}")
          if(NOT HAS_GENERIC)
            continue()
          endif()
        endif()
      endif()
      set(${PATH_VAR} "${FOUND}" PARENT_SCOPE)
      set(${KEY_VAR} "${PACKAGE_NAME}" PARENT_SCOPE)
      set(${SPECIFICITY_VAR} "generic" PARENT_SCOPE)
      _catalog_recipe_origin_of(${RECIPE_LIST} "${PACKAGE_NAME}" ORIGIN)
      set(${ORIGIN_VAR} "${ORIGIN}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  set(${PATH_VAR} "" PARENT_SCOPE)
  set(${KEY_VAR} "" PARENT_SCOPE)
  set(${SPECIFICITY_VAR} "" PARENT_SCOPE)
  set(${ORIGIN_VAR} "" PARENT_SCOPE)
endfunction()

function(_catalog_recipe_kinds PACKAGE_NAME RESULT_VAR)
  set(KINDS "")
  foreach(KIND lib exe)
    _catalog_locate_recipe("${PACKAGE_NAME}" ${KIND} _path _key SPECIFICITY _origin)
    if(NOT "${SPECIFICITY}" STREQUAL "")
      list(APPEND KINDS "${KIND}:${SPECIFICITY}")
    endif()
  endforeach()
  set(${RESULT_VAR} "${KINDS}" PARENT_SCOPE)
endfunction()

function(_catalog_find_recipe PACKAGE_NAME KIND RECIPE_PATH_VAR RECIPE_KEY_VAR)
  _catalog_locate_recipe("${PACKAGE_NAME}" "${KIND}" RECIPE_PATH RECIPE_KEY SPECIFICITY _origin)
  if(NOT "${SPECIFICITY}" STREQUAL "")
    set(${RECIPE_PATH_VAR} "${RECIPE_PATH}" PARENT_SCOPE)
    set(${RECIPE_KEY_VAR} "${RECIPE_KEY}" PARENT_SCOPE)
    return()
  endif()

  if(NOT _CATALOG_ALL_RECIPES AND NOT _CATALOG_DIRECT_RECIPES)
    _catalog_log(FATAL_ERROR "No recipes or repositories loaded. Use catalog_repo() or catalog_add_recipe() first.")
  elseif(KIND STREQUAL "lib")
    _catalog_log(FATAL_ERROR "Recipe not found: ${PACKAGE_NAME}")
  else()
    _catalog_log(FATAL_ERROR "Recipe not found: ${PACKAGE_NAME} (no ${KIND} recipe)")
  endif()
endfunction()

function(_catalog_alias_target PACKAGE_NAME)
  if(TARGET deps::${PACKAGE_NAME})
    return()
  endif()

  _catalog_find_target_alias(${PACKAGE_NAME} TARGET_NAME)
  
  if(TARGET_NAME)
    get_target_property(TARGET_KIND ${TARGET_NAME} TYPE)
    if(TARGET_KIND STREQUAL "EXECUTABLE")
      add_executable(deps::${PACKAGE_NAME} ALIAS ${TARGET_NAME})
    else()
      add_library(deps::${PACKAGE_NAME} ALIAS ${TARGET_NAME})
    endif()
    _catalog_log_verbose("Created alias deps::${PACKAGE_NAME} -> ${TARGET_NAME}")
    return()
  endif()
  
  _catalog_log_verbose("No target found for ${PACKAGE_NAME} in this stage")
endfunction()

function(_catalog_execute_stage PACKAGE_NAME STAGE)
  if(TARGET deps::${PACKAGE_NAME})
    return()
  endif()

  set(RECIPE_FUNC "_recipe_${PACKAGE_NAME}_${STAGE}")
  _catalog_set_var("STAGE" "${STAGE}")
  
  if(COMMAND ${RECIPE_FUNC})
    _catalog_log_verbose("Executing ${STAGE} stage for ${PACKAGE_NAME}")
    if(CMAKE_CROSSCOMPILING AND STAGE STREQUAL "system")
      foreach(FIND_KIND PACKAGE LIBRARY INCLUDE)
        if(NOT DEFINED CMAKE_FIND_ROOT_PATH_MODE_${FIND_KIND})
          set(CMAKE_FIND_ROOT_PATH_MODE_${FIND_KIND} ONLY)
        endif()
      endforeach()
      if("${CMAKE_FIND_ROOT_PATH}" STREQUAL "" AND "${CMAKE_SYSROOT}" STREQUAL "")
        set(CMAKE_FIND_ROOT_PATH "${CMAKE_BINARY_DIR}/.catalog-empty-root")
      endif()
    endif()
    get_property(PREVIOUS_PACKAGE GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE)
    set_property(GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE "${PACKAGE_NAME}")
    cmake_language(CALL ${RECIPE_FUNC})
    set_property(GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE "${PREVIOUS_PACKAGE}")
  endif()
  
  _catalog_alias_target(${PACKAGE_NAME})
endfunction()

function(_catalog_prompt_install PACKAGE_NAME)
  set(_CATALOG_FAILED_PACKAGE_STAGE FALSE PARENT_SCOPE)

  set(IS_INTERACTIVE TRUE)
  _catalog_is_var_defined("NON_INTERACTIVE" HAS_NON_INTERACTIVE ENV)
  if(DEFINED ENV{CI} OR HAS_NON_INTERACTIVE)
    set(IS_INTERACTIVE FALSE)
  endif()
  
  if(NOT IS_INTERACTIVE)
    _catalog_log_verbose("Non-interactive environment detected, skipping package installation prompt.")
    set(_CATALOG_FAILED_PACKAGE_STAGE TRUE PARENT_SCOPE)
    return()
  endif()
  
  _catalog_get_var("PACKAGE_MANAGER" CATALOG_PACKAGE_MANAGER ENV)
  _catalog_get_var("PACKAGE_NAME" CATALOG_PACKAGE_NAME)
  
  _catalog_log(STATUS "Install ${PACKAGE_NAME} using ${CATALOG_PACKAGE_MANAGER}? [y/n]")
  
  execute_process(
    COMMAND sh -c "read REPLY; printf '%s' \"\$REPLY\""
    OUTPUT_VARIABLE USER_INPUT
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    TIMEOUT 30
  )
  
  if(USER_INPUT MATCHES "^[yY]([eE][sS])?$")
    _catalog_log(STATUS "Installing ${PACKAGE_NAME}...")
    
    _catalog_package_install_command("${CATALOG_PACKAGE_MANAGER}" "${CATALOG_PACKAGE_NAME}" INSTALL_CMD)
    if("${INSTALL_CMD}" STREQUAL "")
      _catalog_log_verbose("Unknown package manager detected, trying remaining stages...")
      set(_CATALOG_FAILED_PACKAGE_STAGE TRUE PARENT_SCOPE)
      return()
    endif()
    execute_process(COMMAND sh -c "${INSTALL_CMD}")
    
    _catalog_log_verbose("Installation command executed.")
  else()
    _catalog_log_verbose(STATUS "${PACKAGE_NAME}: package install skipped, trying remaining stages...")
    set(_CATALOG_FAILED_PACKAGE_STAGE TRUE PARENT_SCOPE)
  endif()
endfunction()

function(_catalog_resolve_dependency PACKAGE_NAME)
  get_property(PARENT_PACKAGE GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE)
  set_property(GLOBAL APPEND PROPERTY _CATALOG_TOUCHED "${PACKAGE_NAME}")
  if(NOT "${PARENT_PACKAGE}" STREQUAL "" AND NOT "${PARENT_PACKAGE}" STREQUAL "${PACKAGE_NAME}")
    set_property(GLOBAL APPEND PROPERTY "_CATALOG_REQUIRES_${PARENT_PACKAGE}" "${PACKAGE_NAME}")
  endif()

  if(TARGET deps::${PACKAGE_NAME})
    _catalog_log_verbose("${PACKAGE_NAME}: already resolved, skipping")
    return()
  endif()
  
  set(REQ_TYPE "")
  if(ARGC GREATER 1)
    set(REQ_TYPE "${ARGV1}")
  endif()

  set(VERSION_SPEC "")
  if(ARGC GREATER 2)
    set(VERSION_SPEC "${ARGV2}")
  endif()

  set(OPTION_OVERRIDES "")
  if(ARGC GREATER 3)
    set(OPTION_OVERRIDES "${ARGV3}")
  endif()

  set(PATCH_OVERRIDES "")
  if(ARGC GREATER 4)
    set(PATCH_OVERRIDES "${ARGV4}")
  endif()

  set(FORCE_SOURCE FALSE)
  if(ARGC GREATER 5)
    set(FORCE_SOURCE "${ARGV5}")
  endif()

  if(NOT OPTION_OVERRIDES STREQUAL "")
    _catalog_set_var("${PACKAGE_NAME}_OPTIONS" "${OPTION_OVERRIDES}")
  endif()

  if(NOT PATCH_OVERRIDES STREQUAL "")
    _catalog_set_var("${PACKAGE_NAME}_PATCHES" "${PATCH_OVERRIDES}")
  endif()

  if(FORCE_SOURCE)
    _catalog_set_var("FORCE_source_${PACKAGE_NAME}" TRUE)
  endif()

  if(VERSION_SPEC STREQUAL "")
    _catalog_get_var("${PACKAGE_NAME}_VERSION" VERSION_SPEC)
    if(VERSION_SPEC STREQUAL "")
      _catalog_get_var("VERSION" VERSION_SPEC)
    endif()
  endif()

  if(NOT VERSION_SPEC STREQUAL "")
    set_property(GLOBAL APPEND PROPERTY "_CATALOG_${PACKAGE_NAME}_VERSION_REQS" "${VERSION_SPEC}")
  endif()

  _catalog_resolve_version_conflict("${PACKAGE_NAME}" EFFECTIVE_VERSION EFFECTIVE_REQ)

  _catalog_set_var("REQ_VERSION" "${EFFECTIVE_VERSION}")
  _catalog_set_var("VERSION" "${EFFECTIVE_VERSION}")
  _catalog_set_var("VERSION_REQ" "${EFFECTIVE_REQ}")
  _catalog_set_var("${PACKAGE_NAME}_VERSION" "${EFFECTIVE_VERSION}")
  _catalog_set_var("${PACKAGE_NAME}_REQ_VERSION" "${EFFECTIVE_VERSION}")
  _catalog_set_var("${PACKAGE_NAME}_VERSION_REQ" "${EFFECTIVE_REQ}")

  if(REQ_TYPE STREQUAL "")
    _catalog_get_var("${PACKAGE_NAME}_REQ_TYPE" REQ_TYPE)
    if(REQ_TYPE STREQUAL "")
      _catalog_get_var("REQ_TYPE" REQ_TYPE)
    endif()
  endif()

  if(REQ_TYPE STREQUAL "")
    _catalog_is_var_defined("${PACKAGE_NAME}_STATIC" HAS_PKG_STATIC)
    _catalog_is_var_defined("STATIC" HAS_STATIC)
    _catalog_is_var_defined("${PACKAGE_NAME}_SHARED" HAS_PKG_SHARED)
    _catalog_is_var_defined("SHARED" HAS_SHARED)
    _catalog_is_var_defined("${PACKAGE_NAME}_PREFER_STATIC" HAS_PKG_PSTATIC)
    _catalog_is_var_defined("PREFER_STATIC" HAS_PSTATIC)
    _catalog_is_var_defined("${PACKAGE_NAME}_PREFER_SHARED" HAS_PKG_PSHARED)
    _catalog_is_var_defined("PREFER_SHARED" HAS_PSHARED)

    if(HAS_PKG_STATIC OR HAS_STATIC)
      set(REQ_TYPE "STATIC")
    elseif(HAS_PKG_SHARED OR HAS_SHARED)
      set(REQ_TYPE "SHARED")
    elseif(HAS_PKG_PSTATIC OR HAS_PSTATIC)
      set(REQ_TYPE "PREFER_STATIC")
    elseif(HAS_PKG_PSHARED OR HAS_PSHARED)
      set(REQ_TYPE "PREFER_SHARED")
    endif()
  endif()

  _catalog_set_var("REQ_TYPE" "${REQ_TYPE}")
  _catalog_set_var("${PACKAGE_NAME}_REQ_TYPE" "${REQ_TYPE}")

  set(CATALOG_STATIC FALSE)
  set(CATALOG_SHARED FALSE)
  set(CATALOG_PREFER_STATIC FALSE)
  set(CATALOG_PREFER_SHARED FALSE)
  set(CATALOG_REQUIRE_STATIC FALSE)
  set(CATALOG_REQUIRE_SHARED FALSE)

  if(REQ_TYPE STREQUAL "STATIC")
    set(CATALOG_STATIC TRUE)
    set(CATALOG_REQUIRE_STATIC TRUE)
  elseif(REQ_TYPE STREQUAL "SHARED")
    set(CATALOG_SHARED TRUE)
    set(CATALOG_REQUIRE_SHARED TRUE)
  elseif(REQ_TYPE STREQUAL "PREFER_STATIC")
    set(CATALOG_STATIC TRUE)
    set(CATALOG_PREFER_STATIC TRUE)
  elseif(REQ_TYPE STREQUAL "PREFER_SHARED")
    set(CATALOG_SHARED TRUE)
    set(CATALOG_PREFER_SHARED TRUE)
  endif()

  _catalog_set_var("STATIC" "${CATALOG_STATIC}")
  _catalog_set_var("SHARED" "${CATALOG_SHARED}")
  _catalog_set_var("PREFER_STATIC" "${CATALOG_PREFER_STATIC}")
  _catalog_set_var("PREFER_SHARED" "${CATALOG_PREFER_SHARED}")
  _catalog_set_var("REQUIRE_STATIC" "${CATALOG_REQUIRE_STATIC}")
  _catalog_set_var("REQUIRE_SHARED" "${CATALOG_REQUIRE_SHARED}")
  
  _catalog_set_var("${PACKAGE_NAME}_STATIC" "${CATALOG_STATIC}")
  _catalog_set_var("${PACKAGE_NAME}_SHARED" "${CATALOG_SHARED}")
  _catalog_set_var("${PACKAGE_NAME}_PREFER_STATIC" "${CATALOG_PREFER_STATIC}")
  _catalog_set_var("${PACKAGE_NAME}_PREFER_SHARED" "${CATALOG_PREFER_SHARED}")
  _catalog_set_var("${PACKAGE_NAME}_REQUIRE_STATIC" "${CATALOG_REQUIRE_STATIC}")
  _catalog_set_var("${PACKAGE_NAME}_REQUIRE_SHARED" "${CATALOG_REQUIRE_SHARED}")

  _catalog_is_var_defined("REFRESH_${PACKAGE_NAME}" SHOULD_REFRESH_RECIPE)

  _catalog_get_var("KIND" PKG_KIND)
  if(NOT PKG_KIND STREQUAL "exe" OR NOT "${PARENT_PACKAGE}" STREQUAL "")
    set(PKG_KIND "lib")
  endif()
  _catalog_set_var("KIND" "${PKG_KIND}")

  _catalog_get_var("INSTALL_PREFIX" _INSTALL_PREFIX_VAL)
  if(NOT "${_INSTALL_PREFIX_VAL}" STREQUAL "")
    _catalog_set_var("INSTALL_PREFIX" "${_INSTALL_PREFIX_VAL}")
  endif()

  _catalog_find_recipe(${PACKAGE_NAME} ${PKG_KIND} RECIPE_PATH RECIPE_KEY)
  _catalog_load_recipe(${RECIPE_PATH} RECIPE_FILE ${SHOULD_REFRESH_RECIPE})

  get_property(_PKG_REPO_BASE GLOBAL PROPERTY "_CATALOG_REPO_BASE_${RECIPE_KEY}")
  _catalog_set_var("REPO_BASE" "${_PKG_REPO_BASE}")

  include(${RECIPE_FILE})

  _catalog_is_var_defined("QUERY_LATEST" QUERY_LATEST)
  if(QUERY_LATEST)
    set(LATEST_FUNC "_recipe_${PACKAGE_NAME}_latest")
    if(COMMAND ${LATEST_FUNC})
      get_property(PREVIOUS_PACKAGE GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE)
      set_property(GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE "${PACKAGE_NAME}")
      cmake_language(CALL ${LATEST_FUNC})
      set_property(GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE "${PREVIOUS_PACKAGE}")
    endif()
    return()
  endif()
  
  set(STAGES toolchain system package prebuilt source)
  
  _catalog_get_var("STAGES" CATALOG_STAGES_VAL)
  if(NOT "${CATALOG_STAGES_VAL}" STREQUAL "")
    set(STAGES ${CATALOG_STAGES_VAL})
  endif()
  
  _catalog_get_var("${PACKAGE_NAME}_STAGES" PKG_STAGES_VAL)
  if(NOT "${PKG_STAGES_VAL}" STREQUAL "")
    set(STAGES ${PKG_STAGES_VAL})
  endif()
  
  set(FORCED_STAGE "")
  foreach(S ${STAGES})
    _catalog_get_var("FORCE_${S}_${PACKAGE_NAME}" FORCE_VAL)
    if(FORCE_VAL)
      set(FORCED_STAGE "${S}")
      break()
    endif()
  endforeach()
  
  if(NOT FORCED_STAGE STREQUAL "")
    set(STAGES "${FORCED_STAGE}")
  endif()
  
  foreach(STAGE ${STAGES})
    _catalog_is_var_defined("DISABLE_${STAGE}_${PACKAGE_NAME}" IS_DISABLED)
    if(IS_DISABLED)
      continue()
    endif()
    
    set(PKG_CONFIG_USE_STATIC_LIBS ${CATALOG_STATIC})
    if(STAGE STREQUAL "package")
      _catalog_is_var_defined("DISABLE_system_${PACKAGE_NAME}" IS_SYS_DISABLED)
      if(IS_SYS_DISABLED)
        continue()
      endif()

      set(RECIPE_FUNC "_recipe_${PACKAGE_NAME}_package")
      if(COMMAND ${RECIPE_FUNC})
        _catalog_log_verbose("Querying package stage for ${PACKAGE_NAME}")
        get_property(PREVIOUS_PACKAGE GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE)
        set_property(GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE "${PACKAGE_NAME}")
        cmake_language(CALL ${RECIPE_FUNC})
        set_property(GLOBAL PROPERTY _CATALOG_CURRENT_PACKAGE "${PREVIOUS_PACKAGE}")
        
        _catalog_get_var("PACKAGE_NAME" CATALOG_PACKAGE_NAME)
        _catalog_get_var("PACKAGE_MANAGER" CATALOG_PACKAGE_MANAGER ENV)
        if(NOT "${CATALOG_PACKAGE_NAME}" STREQUAL "" AND NOT "${CATALOG_PACKAGE_MANAGER}" STREQUAL "")
          _catalog_prompt_install(${PACKAGE_NAME})
          if(_CATALOG_FAILED_PACKAGE_STAGE)
            continue()
          endif()

          _catalog_execute_stage(${PACKAGE_NAME} system)
          
          if(TARGET deps::${PACKAGE_NAME})
            _catalog_log_verbose(STATUS "${PACKAGE_NAME}: resolved via package manager")
            unset(PKG_CONFIG_USE_STATIC_LIBS)
            return()
          endif()
        endif()
        unset(CATALOG_PACKAGE_NAME)
        unset(CL_PACKAGE_NAME)
      endif()
    else()
      _catalog_execute_stage(${PACKAGE_NAME} ${STAGE})
      
      if(TARGET deps::${PACKAGE_NAME})
        _catalog_log(STATUS "${PACKAGE_NAME}: resolved via ${STAGE}")
        unset(PKG_CONFIG_USE_STATIC_LIBS)
        return()
      endif()
    endif()
  endforeach()
  
  unset(PKG_CONFIG_USE_STATIC_LIBS)
  _catalog_log(FATAL_ERROR "Failed to resolve dependency: ${PACKAGE_NAME}")
endfunction()
