function(_cl_manifest_key NAME KIND OUT)
  if(KIND STREQUAL "exe")
    set(${OUT} "${NAME}#exe" PARENT_SCOPE)
  else()
    set(${OUT} "${NAME}" PARENT_SCOPE)
  endif()
endfunction()

function(_cl_key_split KEY NAME_OUT KIND_OUT)
  if(KEY MATCHES "^(.*)#exe$")
    set(${NAME_OUT} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(${KIND_OUT} "exe" PARENT_SCOPE)
  else()
    set(${NAME_OUT} "${KEY}" PARENT_SCOPE)
    set(${KIND_OUT} "lib" PARENT_SCOPE)
  endif()
endfunction()

function(_cl_label NAME KIND OUT)
  if(KIND STREQUAL "exe")
    set(${OUT} "${NAME} (exe)" PARENT_SCOPE)
  else()
    set(${OUT} "${NAME}" PARENT_SCOPE)
  endif()
endfunction()

function(_cl_key_label KEY OUT)
  _cl_key_split("${KEY}" N K)
  _cl_label("${N}" "${K}" L)
  set(${OUT} "${L}" PARENT_SCOPE)
endfunction()

function(_cl_manifest_file OUT)
  set(${OUT} "${CL_PREFIX}/share/catalog/manifest.json" PARENT_SCOPE)
endfunction()

function(_cl_manifest_load)
  _cl_manifest_file(FILE)
  if(EXISTS "${FILE}")
    file(READ "${FILE}" JSON)
    string(JSON SCHEMA ERROR_VARIABLE ERR GET "${JSON}" schema)
    if(ERR)
      _cl_die("manifest ${FILE} is not valid (${ERR})")
    endif()
    if(SCHEMA GREATER 1)
      _cl_die("manifest ${FILE} was written by a newer catalog (schema ${SCHEMA})")
    endif()
  else()
    set(JSON [=[{"schema": 1, "target": {}, "packages": {}}]=])
  endif()
  set_property(GLOBAL PROPERTY _CL_MANIFEST "${JSON}")
endfunction()

function(_cl_manifest_save)
  _cl_manifest_file(FILE)
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)
  get_filename_component(DIR "${FILE}" DIRECTORY)
  file(MAKE_DIRECTORY "${DIR}")
  file(WRITE "${FILE}.tmp" "${JSON}\n")
  file(RENAME "${FILE}.tmp" "${FILE}")
endfunction()

function(_cl_manifest_json OUT)
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)
  set(${OUT} "${JSON}" PARENT_SCOPE)
endfunction()

function(_cl_manifest_set_target)
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)

  string(JSON OLD_TC ERROR_VARIABLE ERR GET "${JSON}" target toolchain)
  if(NOT ERR AND NOT "${OLD_TC}" STREQUAL "" AND NOT "${OLD_TC}" STREQUAL "${CL_TOOLCHAIN}")
    _cl_warn("this prefix (${CL_PREFIX}) was created with a different toolchain:\n"
             "  recorded: ${OLD_TC}\n  current:  ${CL_TOOLCHAIN}\n"
             "Use --target <name> to keep the two apart.")
  endif()

  foreach(PAIR "id:${CL_TARGET_ID}" "system:${CL_SYSTEM}" "arch:${CL_ARCH}" "toolchain:${CL_TOOLCHAIN}")
    string(FIND "${PAIR}" ":" POS)
    string(SUBSTRING "${PAIR}" 0 ${POS} K)
    math(EXPR POS "${POS} + 1")
    string(SUBSTRING "${PAIR}" ${POS} -1 V)
    _cl_json_quote("${V}" Q)
    string(JSON JSON SET "${JSON}" target "${K}" "${Q}")
  endforeach()
  if(CL_CROSS)
    string(JSON JSON SET "${JSON}" target cross true)
  else()
    string(JSON JSON SET "${JSON}" target cross false)
  endif()

  set_property(GLOBAL PROPERTY _CL_MANIFEST "${JSON}")
endfunction()

function(_cl_manifest_has NAME OUT)
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)
  string(JSON V ERROR_VARIABLE ERR TYPE "${JSON}" packages "${NAME}")
  if(ERR)
    set(${OUT} FALSE PARENT_SCOPE)
  else()
    set(${OUT} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(_cl_manifest_field NAME FIELD OUT)
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)
  string(JSON V ERROR_VARIABLE ERR GET "${JSON}" packages "${NAME}" "${FIELD}")
  if(ERR)
    set(${OUT} "" PARENT_SCOPE)
  else()
    set(${OUT} "${V}" PARENT_SCOPE)
  endif()
endfunction()

function(_cl_manifest_names OUT)
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)
  string(JSON COUNT LENGTH "${JSON}" packages)
  set(NAMES "")
  if(COUNT GREATER 0)
    math(EXPR LAST "${COUNT} - 1")
    foreach(I RANGE 0 ${LAST})
      string(JSON N MEMBER "${JSON}" packages ${I})
      list(APPEND NAMES "${N}")
    endforeach()
  endif()
  list(SORT NAMES)
  set(${OUT} "${NAMES}" PARENT_SCOPE)
endfunction()

function(_cl_manifest_put NAME)
  cmake_parse_arguments(P "" "MANAGED_BY;STAGE;REQUESTED;TYPE;PACKAGE_MANAGER;PACKAGE_NAME;FILES;SOURCE;KIND;VERSION;REASON" "REQUIRES" ${ARGN})
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)

  _cl_now(NOW)
  if("${P_VERSION}" STREQUAL "")
    set(P_VERSION "unknown")
  endif()
  if("${P_REASON}" STREQUAL "")
    set(P_REASON "explicit")
  endif()
  set(KIND_NAME "library")
  if(P_KIND STREQUAL "application")
    set(KIND_NAME "application")
  endif()
  set(ENTRY "{}")
  foreach(PAIR
      "kind:${KIND_NAME}" "managed_by:${P_MANAGED_BY}" "stage:${P_STAGE}" "requested:${P_REQUESTED}"
      "type:${P_TYPE}" "package_manager:${P_PACKAGE_MANAGER}" "package_name:${P_PACKAGE_NAME}"
      "version:${P_VERSION}" "reason:${P_REASON}" "files:${P_FILES}" "source:${P_SOURCE}" "installed_at:${NOW}")
    string(FIND "${PAIR}" ":" POS)
    string(SUBSTRING "${PAIR}" 0 ${POS} K)
    math(EXPR POS "${POS} + 1")
    string(SUBSTRING "${PAIR}" ${POS} -1 V)
    if(NOT "${V}" STREQUAL "")
      _cl_json_quote("${V}" Q)
      string(JSON ENTRY SET "${ENTRY}" "${K}" "${Q}")
    endif()
  endforeach()

  if(P_REQUIRES)
    list(REMOVE_DUPLICATES P_REQUIRES)
    set(ARRAY "")
    foreach(R ${P_REQUIRES})
      _cl_json_quote("${R}" Q)
      list(APPEND ARRAY "${Q}")
    endforeach()
    string(JOIN "," ARRAY_TEXT ${ARRAY})
    string(JSON ENTRY SET "${ENTRY}" requires "[${ARRAY_TEXT}]")
  endif()

  string(JSON JSON SET "${JSON}" packages "${NAME}" "${ENTRY}")
  set_property(GLOBAL PROPERTY _CL_MANIFEST "${JSON}")
endfunction()

function(_cl_manifest_requires KEY OUT)
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)
  set(NAMES "")
  string(JSON COUNT ERROR_VARIABLE ERR LENGTH "${JSON}" packages "${KEY}" requires)
  if(NOT ERR AND COUNT GREATER 0)
    math(EXPR LAST "${COUNT} - 1")
    foreach(I RANGE 0 ${LAST})
      string(JSON R GET "${JSON}" packages "${KEY}" requires ${I})
      list(APPEND NAMES "${R}")
    endforeach()
  endif()
  set(${OUT} "${NAMES}" PARENT_SCOPE)
endfunction()

# the manifest keys of the packages that require the library NAME
function(_cl_manifest_dependents NAME OUT)
  _cl_manifest_names(KEYS)
  set(DEPENDENTS "")
  foreach(KEY ${KEYS})
    _cl_manifest_requires("${KEY}" REQUIRED)
    if("${NAME}" IN_LIST REQUIRED AND NOT "${KEY}" STREQUAL "${NAME}")
      list(APPEND DEPENDENTS "${KEY}")
    endif()
  endforeach()
  set(${OUT} "${DEPENDENTS}" PARENT_SCOPE)
endfunction()

function(_cl_manifest_remove NAME)
  get_property(JSON GLOBAL PROPERTY _CL_MANIFEST)
  string(JSON JSON REMOVE "${JSON}" packages "${NAME}")
  set_property(GLOBAL PROPERTY _CL_MANIFEST "${JSON}")
endfunction()

function(_cl_manifest_files_path NAME OUT)
  set(${OUT} "${CL_PREFIX}/share/catalog/files/${NAME}.txt" PARENT_SCOPE)
endfunction()

function(_cl_manifest_write_files NAME FILES)
  _cl_manifest_files_path("${NAME}" PATH)
  get_filename_component(DIR "${PATH}" DIRECTORY)
  file(MAKE_DIRECTORY "${DIR}")
  list(REMOVE_DUPLICATES FILES)
  list(SORT FILES)
  string(REPLACE ";" "\n" TEXT "${FILES}")
  file(WRITE "${PATH}" "${TEXT}\n")
endfunction()

function(_cl_manifest_read_files NAME OUT)
  _cl_manifest_files_path("${NAME}" PATH)
  set(LINES "")
  if(EXISTS "${PATH}")
    file(STRINGS "${PATH}" LINES)
  endif()
  set(${OUT} "${LINES}" PARENT_SCOPE)
endfunction()
