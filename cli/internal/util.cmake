set(CL_VERSION "0.1.0")


function(_cl_say TEXT)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${TEXT}")
endfunction()

function(_cl_info)
  string(CONCAT TEXT ${ARGV})
  message(NOTICE "catalog: ${TEXT}")
endfunction()

function(_cl_warn)
  string(CONCAT TEXT ${ARGV})
  message(NOTICE "catalog: warning: ${TEXT}")
endfunction()

function(_cl_verbose)
  if(CL_VERBOSE)
    string(CONCAT TEXT ${ARGV})
    message(NOTICE "catalog: ${TEXT}")
  endif()
endfunction()

function(_cl_exit CODE)
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
    cmake_language(EXIT ${CODE})
  else()
    message(FATAL_ERROR "catalog: (exit code ${CODE}; use CMake >= 3.29 for clean exit codes)")
  endif()
endfunction()

function(_cl_die)
  string(CONCAT TEXT ${ARGV})
  message(NOTICE "catalog: error: ${TEXT}")
  _cl_exit(1)
endfunction()

function(_cl_json_quote VALUE OUT)
  string(REPLACE "\\" "\\\\" V "${VALUE}")
  string(REPLACE "\"" "\\\"" V "${V}")
  string(REPLACE "\n" "\\n" V "${V}")
  string(REPLACE "\r" "\\r" V "${V}")
  string(REPLACE "\t" "\\t" V "${V}")
  set(${OUT} "\"${V}\"" PARENT_SCOPE)
endfunction()

function(_cl_now OUT)
  string(TIMESTAMP T "%Y-%m-%dT%H:%M:%SZ" UTC)
  set(${OUT} "${T}" PARENT_SCOPE)
endfunction()

function(_cl_is_noninteractive OUT)
  if(DEFINED ENV{CI} OR DEFINED ENV{CATALOG_NON_INTERACTIVE} OR DEFINED ENV{CL_NON_INTERACTIVE})
    set(${OUT} TRUE PARENT_SCOPE)
  else()
    set(${OUT} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(_cl_confirm QUESTION OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(CMAKE_HOST_WIN32)
    return()
  endif()
  find_program(_CL_SH sh)
  if(NOT _CL_SH)
    return()
  endif()
  if("DEFAULT_YES" IN_LIST ARGN)
    set(HINT "Y/n")
  else()
    set(HINT "y/N")
  endif()
  message(NOTICE "catalog: ${QUESTION} [${HINT}]")
  execute_process(
    COMMAND "${_CL_SH}" -c "read ANSWER && printf 'A%s' \"$ANSWER\""
    OUTPUT_VARIABLE ANSWER
    ERROR_QUIET
  )
  if(NOT ANSWER MATCHES "^A")
    return()
  endif()
  string(SUBSTRING "${ANSWER}" 1 -1 ANSWER)
  if(ANSWER MATCHES "^[yY]([eE][sS])?$")
    set(${OUT} TRUE PARENT_SCOPE)
  elseif(ANSWER STREQUAL "" AND "DEFAULT_YES" IN_LIST ARGN)
    set(${OUT} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(_cl_absolutize_local VALUE OUT)
  if(VALUE MATCHES "^\\.\\.?/" OR (EXISTS "${VALUE}" AND NOT VALUE MATCHES "^[a-zA-Z][a-zA-Z0-9+.-]*://"))
    file(REAL_PATH "${VALUE}" ABS BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
    set(${OUT} "${ABS}" PARENT_SCOPE)
  else()
    set(${OUT} "${VALUE}" PARENT_SCOPE)
  endif()
endfunction()

macro(_cl_take_value)
  if(_has_inline)
    set(_value "${_inline}")
  elseif(_i LESS _n)
    list(GET _args ${_i} _value)
    math(EXPR _i "${_i} + 1")
  else()
    _cl_die("option ${_arg} requires a value")
  endif()
endmacro()

function(_cl_parse_args)
  set(_args ${ARGN})
  list(LENGTH _args _n)

  set(OPT_TOOLCHAIN "")
  set(OPT_TARGET "")
  set(OPT_PREFIX "")
  set(OPT_REPOS "")
  set(OPT_NO_DEFAULT_REPO FALSE)
  set(OPT_RECIPES "")
  set(OPT_DEFINES "")
  set(OPT_BUILD_TYPE "")
  set(OPT_TYPE "")
  set(OPT_SOURCE FALSE)
  set(OPT_FORCE FALSE)
  set(OPT_DRY_RUN FALSE)
  set(OPT_REFRESH FALSE)
  set(OPT_YES FALSE)
  set(OPT_VERBOSE FALSE)
  set(OPT_JSON FALSE)
  set(OPT_HELP FALSE)
  set(OPT_SHOW_VERSION FALSE)
  set(CMD "")
  set(PKGS "")

  set(_i 0)
  while(_i LESS _n)
    list(GET _args ${_i} _arg)
    math(EXPR _i "${_i} + 1")

    set(_has_inline FALSE)
    set(_inline "")
    if(_arg MATCHES "^(--[a-z][a-z0-9-]*)=(.*)$")
      set(_arg "${CMAKE_MATCH_1}")
      set(_inline "${CMAKE_MATCH_2}")
      set(_has_inline TRUE)
    endif()

    if(_arg STREQUAL "--toolchain")
      _cl_take_value()
      set(OPT_TOOLCHAIN "${_value}")
    elseif(_arg STREQUAL "--target")
      _cl_take_value()
      set(OPT_TARGET "${_value}")
    elseif(_arg STREQUAL "--prefix")
      _cl_take_value()
      set(OPT_PREFIX "${_value}")
    elseif(_arg STREQUAL "--repo")
      _cl_take_value()
      list(APPEND OPT_REPOS "${_value}")
    elseif(_arg STREQUAL "--recipe")
      _cl_take_value()
      list(APPEND OPT_RECIPES "${_value}")
    elseif(_arg STREQUAL "--build-type")
      _cl_take_value()
      set(OPT_BUILD_TYPE "${_value}")
    elseif(_arg STREQUAL "--define" OR _arg STREQUAL "-D")
      _cl_take_value()
      list(APPEND OPT_DEFINES "${_value}")
    elseif(_arg MATCHES "^-D(.+)$")
      list(APPEND OPT_DEFINES "${CMAKE_MATCH_1}")
    elseif(_arg STREQUAL "--no-default-repo")
      set(OPT_NO_DEFAULT_REPO TRUE)
    elseif(_arg STREQUAL "--static")
      set(OPT_TYPE "STATIC")
    elseif(_arg STREQUAL "--shared")
      set(OPT_TYPE "SHARED")
    elseif(_arg STREQUAL "--source")
      set(OPT_SOURCE TRUE)
    elseif(_arg STREQUAL "--force" OR _arg STREQUAL "-f")
      set(OPT_FORCE TRUE)
    elseif(_arg STREQUAL "--dry-run" OR _arg STREQUAL "-n")
      set(OPT_DRY_RUN TRUE)
    elseif(_arg STREQUAL "--refresh")
      set(OPT_REFRESH TRUE)
    elseif(_arg STREQUAL "--yes" OR _arg STREQUAL "-y")
      set(OPT_YES TRUE)
    elseif(_arg STREQUAL "--verbose" OR _arg STREQUAL "-V")
      set(OPT_VERBOSE TRUE)
    elseif(_arg STREQUAL "--json")
      set(OPT_JSON TRUE)
    elseif(_arg STREQUAL "--help" OR _arg STREQUAL "-h")
      set(OPT_HELP TRUE)
    elseif(_arg STREQUAL "--version")
      set(OPT_SHOW_VERSION TRUE)
    elseif(_arg MATCHES "^-")
      _cl_die("unknown option: ${_arg} (see `catalog help`)")
    elseif(CMD STREQUAL "")
      set(CMD "${_arg}")
    else()
      list(APPEND PKGS "${_arg}")
    endif()
  endwhile()

  foreach(_name CMD PKGS OPT_TOOLCHAIN OPT_TARGET OPT_PREFIX OPT_REPOS OPT_NO_DEFAULT_REPO OPT_RECIPES OPT_DEFINES
                OPT_BUILD_TYPE OPT_TYPE OPT_SOURCE OPT_FORCE OPT_DRY_RUN OPT_REFRESH OPT_YES OPT_VERBOSE
                OPT_JSON OPT_HELP OPT_SHOW_VERSION)
    set(CL_${_name} "${${_name}}" PARENT_SCOPE)
  endforeach()
endfunction()

function(_cl_split_package_arg ARG NAME_VAR SPEC_VAR SOURCE_VAR)
  set(SPEC "")
  set(SOURCE "${ARG}")

  if(ARG MATCHES "^gh:[^/]+/([^/@#]+)")
    set(NAME "${CMAKE_MATCH_1}")
  elseif(ARG MATCHES "^https?://[^/]+/[^/]+/([^/@]+)(@.+)?/?$")
    set(NAME "${CMAKE_MATCH_1}")
  elseif(ARG MATCHES "^git@[^:]+:[^/]+/([^/]+)$")
    set(NAME "${CMAKE_MATCH_1}")
  else()
    string(FIND "${ARG}" "@" AT)
    if(AT EQUAL -1)
      set(NAME "${ARG}")
    else()
      string(SUBSTRING "${ARG}" 0 ${AT} NAME)
      math(EXPR REST "${AT} + 1")
      string(SUBSTRING "${ARG}" ${REST} -1 SPEC)
    endif()
    set(SOURCE "${NAME}")
  endif()
  string(REGEX REPLACE "\\.git$" "" NAME "${NAME}")

  _catalog_valid_target_name("${NAME}" VALID)
  if(NOT VALID OR NAME STREQUAL "")
    _cl_die("invalid package name: '${NAME}' (from '${ARG}')")
  endif()
  if(NOT SPEC MATCHES "^[0-9A-Za-z.<>=^~,*+_ -]*$")
    _cl_die("invalid version requirement for ${NAME}: '${SPEC}'")
  endif()
  set(${NAME_VAR} "${NAME}" PARENT_SCOPE)
  set(${SPEC_VAR} "${SPEC}" PARENT_SCOPE)
  set(${SOURCE_VAR} "${SOURCE}" PARENT_SCOPE)
endfunction()
