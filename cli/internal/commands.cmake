function(_cl_usage)
  _cl_say("catalog ${CL_VERSION} - command line interface for Catalog

USAGE
  catalog <command> [options] [packages...]

COMMANDS
  install <package>...         Make libraries or applications available (system, host package manager,
                               prebuilt binary or source)
  remove <package>...          Remove packages installed by Catalog
  list                         Show recorded packages for the target
  search [term]...             List recipes whose name contains a term (all recipes without one)
  check <package>...           Report package availability without changing anything
  outdated [package]...        Compare installed versions with what the recipes install now
  update [package]...          Reinstall the outdated packages that Catalog installed (all by default)
  clean                        Delete cached downloads, checkouts and build trees
  completion <shell>           Print a completion script (bash, zsh or fish)
  env                          Print shell exports (CMAKE_PREFIX_PATH, PKG_CONFIG_PATH, ...)
  prefix                       Print the install prefix of the target
  help, version                Show help or version info

TARGET OPTIONS (cross compilation)
  --toolchain FILE   CMake toolchain file of the target (default: \$CMAKE_TOOLCHAIN_FILE)
  --target NAME      Name of the target, used for caches and work files
                     (default: <system>-<arch>[-<toolchain name>])
  --prefix DIR       Install into DIR
  -D NAME=VALUE      Extra CMake definition(s)

RECIPE OPTIONS
  --repo SPEC        Extra recipe repository
  --recipe NAME=SRC  Single recipe, like catalog_add_recipe() (repeatable; applied last)
  --no-default-repo  Do not load the official repo (catalog-cmake/repo, or $CATALOG_DEFAULT_REPO)
  --refresh          Re-download cached recipes and sources
                     Recipes that are not in the official repo are shown before they run and
                     confirmed (default yes). No question in CI / non-interactive sessions; -y
                     only prints where the recipe comes from.

INSTALL OPTIONS
  --lib, --exe         Install the library or the application of a package (both can be given).
                       A package with both a recipe-lib and a recipe-exe needs one of them
                       (--app is an alias for --exe; also applies to remove, check and search)
  --static | --shared  Require a static or shared build (libraries)
  --no-prebuilt        Do not use prebuilt binaries, build from source instead
  --source             Forcefully build from source (no system, package manager or prebuilt)
  --build-type TYPE    Build type for source builds (default: Release)
  -f, --force          Redo packages that are already in the manifest
  -y, --yes            Skips all prompts (as if they answer was \"yes\")
  -n, --dry-run        install/remove: show what would happen without changing anything

COMPLETION
  bash: source <(catalog completion bash)       fish: catalog completion fish | source
  zsh:  source <(catalog completion zsh)        (or save it as _catalog on your \$fpath)

SEARCH OPTIONS
  -i, --interactive  Pick recipes with fzf

CLEAN OPTIONS
  --all              Clean the caches of all targets, not just the current one
  -n, --dry-run      Also applies to clean: list what would be deleted

OTHER
  --json             list: print the manifest as JSON
  -V, --verbose      More verbose logging
  -h, --help

MANIFEST
  Each package in <prefix>/share/catalog/manifest.json has a managed_by value:
    system           found on the system, never touched by Catalog
    toolchain        provided by the toolchain
    package-manager  installed by Catalog through the host package manager
    catalog          built by Catalog and installed into the prefix

ENVIRONMENT
  CATALOG_HOME       Where prefixes, caches and work files live
                     (default: \$XDG_DATA_HOME/catalog or ~/.local/share/catalog)
  CATALOG_NON_INTERACTIVE, CI   Never prompt (use --yes to allow the package manager / doas / sudo)
  CATALOG_SUDO       Command used when the prefix is not writable (default: doas, then sudo);
                     'none' disables it.")
endfunction()

function(_cl_pad TEXT WIDTH OUT)
  string(LENGTH "${TEXT}" L)
  set(PAD "")
  if(L LESS WIDTH)
    math(EXPR N "${WIDTH} - ${L}")
    string(REPEAT " " ${N} PAD)
  endif()
  set(${OUT} "${TEXT}${PAD}" PARENT_SCOPE)
endfunction()

function(_cl_describe_target)
  set(TEXT "target ${CL_TARGET_ID} (${CL_SYSTEM}/${CL_ARCH}")
  if(CL_CROSS)
    set(TEXT "${TEXT}, cross-compiling")
  endif()
  _cl_info("${TEXT}), prefix ${CL_PREFIX} (${CL_PREFIX_ORIGIN})")
endfunction()

function(_cl_prefix_writable OUT DIR_OUT)
  set(${OUT} TRUE PARENT_SCOPE)
  if(CMAKE_HOST_WIN32)
    return()
  endif()
  set(D "${CL_PREFIX}")
  while(NOT EXISTS "${D}" AND NOT "${D}" STREQUAL "/")
    get_filename_component(D "${D}" DIRECTORY)
  endwhile()
  execute_process(COMMAND test -w "${D}" RESULT_VARIABLE RC)
  set(${DIR_OUT} "${D}" PARENT_SCOPE)
  if(NOT RC EQUAL 0)
    set(${OUT} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(_cl_find_escalation OUT)
  set(${OUT} "" PARENT_SCOPE)
  if(DEFINED ENV{CATALOG_SUDO})
    if("$ENV{CATALOG_SUDO}" STREQUAL "none" OR "$ENV{CATALOG_SUDO}" STREQUAL "")
      return()
    endif()
    set(CANDIDATES "$ENV{CATALOG_SUDO}")
  else()
    set(CANDIDATES doas sudo)
  endif()
  foreach(C ${CANDIDATES})
    unset(_CL_ESC CACHE)
    find_program(_CL_ESC "${C}")
    if(_CL_ESC)
      set(${OUT} "${_CL_ESC}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

function(_cl_prepare_privileges)
  set(CL_ELEVATE "" PARENT_SCOPE)
  _cl_prefix_writable(WRITABLE D)
  if(WRITABLE)
    return()
  endif()

  _cl_find_escalation(TOOL)
  if("${TOOL}" STREQUAL "")
    _cl_die("no write access to ${D}, which is needed for the prefix ${CL_PREFIX}.\n"
            "  Run catalog as a user who can write there, install sudo or doas so that catalog can\n"
            "  ask for root, or install somewhere you own with --prefix DIR.")
  endif()
  get_filename_component(TOOL_NAME "${TOOL}" NAME)

  if(NOT CL_OPT_YES)
    _cl_is_noninteractive(NI)
    if(NI)
      _cl_die("no write access to ${D}, which is needed for the prefix ${CL_PREFIX}.\n"
              "  Pass --yes to let catalog use ${TOOL_NAME} for the install step, or use --prefix DIR.")
    endif()
    _cl_confirm("${CL_PREFIX} is not writable by you. Catalog builds as you and runs only its own copy-and-record step through ${TOOL_NAME}. Continue?" OK DEFAULT_YES)
    if(NOT OK)
      _cl_die("not continuing without write access to ${CL_PREFIX}. Use --prefix DIR for a location you own.")
    endif()
  endif()
  set(CL_ELEVATE "${TOOL}" PARENT_SCOPE)
endfunction()

function(_cl_begin_mutation)
  _cl_prepare_privileges()
  set(CL_ELEVATE "${CL_ELEVATE}" PARENT_SCOPE)

  string(SHA1 H "${CL_PREFIX}")
  string(SUBSTRING "${H}" 0 12 H)
  set(LOCK "${CL_WORK}/prefix-${H}.lock")
  file(LOCK "${LOCK}" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE LOCK_RC)
  if(NOT LOCK_RC STREQUAL "0")
    _cl_info("waiting for another catalog process that is working on ${CL_PREFIX}...")
    file(LOCK "${LOCK}" GUARD PROCESS TIMEOUT 7200 RESULT_VARIABLE LOCK_RC)
    if(NOT LOCK_RC STREQUAL "0")
      _cl_die("could not lock ${LOCK}: ${LOCK_RC}")
    endif()
  endif()

  _cl_manifest_load()
endfunction()

function(_cl_remove_stage DIR)
  if(NOT "${DIR}" STREQUAL "")
    file(REMOVE_RECURSE "${DIR}")
  endif()
endfunction()

function(_cl_commit OUT OP NAME)
  cmake_parse_arguments(C "" "MANAGED_BY;STAGE;REQUESTED;TYPE;PACKAGE_MANAGER;PACKAGE_NAME;SOURCE;STAGE_DIR;KIND;VERSION" "FILES" ${ARGN})
  string(RANDOM LENGTH 6 ALPHABET "0123456789abcdef" RND)
  set(SPEC "${CL_WORK}/apply-${NAME}-${RND}.spec")
  set(LIST_FILE "${SPEC}.files")

  set(T "")
  string(APPEND T "op=${OP}\nname=${NAME}\nprefix=${CL_PREFIX}\n")
  string(APPEND T "target_id=${CL_TARGET_ID}\nsystem=${CL_SYSTEM}\narch=${CL_ARCH}\ncross=${CL_CROSS}\ntoolchain=${CL_TOOLCHAIN}\n")
  string(APPEND T "managed_by=${C_MANAGED_BY}\nfrom_stage=${C_STAGE}\nrequested=${C_REQUESTED}\ntype=${C_TYPE}\n")
  string(APPEND T "package_manager=${C_PACKAGE_MANAGER}\npackage_name=${C_PACKAGE_NAME}\nsource=${C_SOURCE}\n")
  string(APPEND T "stage_dir=${C_STAGE_DIR}\nkind=${C_KIND}\nversion=${C_VERSION}\n")
  if(C_FILES)
    string(REPLACE ";" "\n" LINES "${C_FILES}")
    file(WRITE "${LIST_FILE}" "${LINES}\n")
    string(APPEND T "files_file=${LIST_FILE}\n")
  endif()
  file(WRITE "${SPEC}" "${T}")

  set(RESULT TRUE)
  if(CL_ELEVATE)
    execute_process(COMMAND "${CL_ELEVATE}" "${CMAKE_COMMAND}" -P "${CL_SELF}" -- __apply "${SPEC}" RESULT_VARIABLE RC)
    if(NOT RC EQUAL 0)
      set(RESULT FALSE)
    endif()
  else()
    _cl_apply_op("${SPEC}")
  endif()

  file(REMOVE "${SPEC}" "${LIST_FILE}")
  _cl_manifest_load()
  set(${OUT} ${RESULT} PARENT_SCOPE)
endfunction()

function(_cl_apply_op SPEC)
  _cl_kv_parse("${SPEC}" A)
  if("${A_prefix}" STREQUAL "" OR "${A_name}" STREQUAL "" OR "${A_op}" STREQUAL "")
    _cl_die("internal error: incomplete apply spec '${SPEC}'")
  endif()
  set(CL_PREFIX "${A_prefix}")
  set(CL_TARGET_ID "${A_target_id}")
  set(CL_SYSTEM "${A_system}")
  set(CL_ARCH "${A_arch}")
  set(CL_CROSS "${A_cross}")
  set(CL_TOOLCHAIN "${A_toolchain}")

  file(MAKE_DIRECTORY "${CL_PREFIX}/share/catalog")
  file(LOCK "${CL_PREFIX}/share/catalog/.lock" GUARD FUNCTION TIMEOUT 7200 RESULT_VARIABLE LOCK_RC)
  if(NOT LOCK_RC STREQUAL "0")
    _cl_die("could not lock ${CL_PREFIX}/share/catalog/.lock: ${LOCK_RC}")
  endif()
  _cl_manifest_load()

  if(A_op STREQUAL "put")
    _cl_manifest_set_target()

    set(FILES "")
    if(NOT "${A_files_file}" STREQUAL "" AND EXISTS "${A_files_file}")
      file(STRINGS "${A_files_file}" FILES)
      list(FILTER FILES EXCLUDE REGEX "^$")
    endif()

    if(NOT "${A_stage_dir}" STREQUAL "")
      string(LENGTH "${A_stage_dir}" STAGE_LEN)
      set(DESTS "")
      foreach(F ${FILES})
        set(DEST "${F}")
        string(FIND "${F}" "${A_stage_dir}/" POS)
        if(POS EQUAL 0)
          string(SUBSTRING "${F}" ${STAGE_LEN} -1 DEST)
        endif()
        string(FIND "${DEST}" "${CL_PREFIX}/" POS)
        if(NOT POS EQUAL 0)
          _cl_die("${A_name}: the build installs ${DEST}, outside the prefix ${CL_PREFIX} (does the toolchain set CMAKE_STAGING_PREFIX?). Nothing was installed.")
        endif()
        if(NOT EXISTS "${A_stage_dir}${DEST}" AND NOT IS_SYMLINK "${A_stage_dir}${DEST}")
          _cl_die("${A_name}: staged file ${A_stage_dir}${DEST} is missing. Nothing was installed.")
        endif()
        list(APPEND DESTS "${DEST}")
      endforeach()
      foreach(DEST ${DESTS})
        get_filename_component(DIR "${DEST}" DIRECTORY)
        file(MAKE_DIRECTORY "${DIR}")
        file(COPY "${A_stage_dir}${DEST}" DESTINATION "${DIR}")
      endforeach()
      set(FILES "${DESTS}")
    else()
      foreach(F ${FILES})
        string(FIND "${F}" "${CL_PREFIX}/" POS)
        if(NOT POS EQUAL 0)
          _cl_warn("${A_name}: installed ${F}, outside the prefix ${CL_PREFIX} (does the toolchain set CMAKE_STAGING_PREFIX?). `remove` will not delete files outside the prefix.")
          break()
        endif()
      endforeach()
    endif()

    _cl_manifest_read_files("${A_name}" OLD_FILES)
    set(STALE_DIRS "")
    foreach(F ${OLD_FILES})
      string(FIND "${F}" "${CL_PREFIX}/" POS)
      if(POS EQUAL 0 AND NOT "${F}" IN_LIST FILES)
        file(REMOVE "${F}")
        get_filename_component(D "${F}" DIRECTORY)
        while(NOT "${D}" STREQUAL "${CL_PREFIX}" AND NOT "${D}" STREQUAL "")
          list(APPEND STALE_DIRS "${D}")
          get_filename_component(D "${D}" DIRECTORY)
        endwhile()
      endif()
    endforeach()
    if(STALE_DIRS)
      _cl_prune_empty_dirs("${STALE_DIRS}")
    endif()

    set(FILES_REF "")
    if(FILES)
      _cl_manifest_write_files("${A_name}" "${FILES}")
      set(FILES_REF "files/${A_name}.txt")
    endif()
    _cl_manifest_put("${A_name}" MANAGED_BY "${A_managed_by}" STAGE "${A_from_stage}" REQUESTED "${A_requested}"
                     TYPE "${A_type}" PACKAGE_MANAGER "${A_package_manager}" PACKAGE_NAME "${A_package_name}"
                     FILES "${FILES_REF}" SOURCE "${A_source}" KIND "${A_kind}" VERSION "${A_version}")
    _cl_manifest_save()

  elseif(A_op STREQUAL "remove")
    _cl_manifest_has("${A_name}" HAS)
    if(NOT HAS)
      return()
    endif()
    _cl_manifest_field("${A_name}" managed_by WHO)
    if(WHO STREQUAL "catalog")
      _cl_manifest_read_files("${A_name}" FILES)
      set(DIRS "")
      set(COUNT 0)
      foreach(F ${FILES})
        string(FIND "${F}" "${CL_PREFIX}/" POS)
        if(NOT POS EQUAL 0)
          _cl_warn("${A_name}: refusing to delete ${F} (outside ${CL_PREFIX})")
          continue()
        endif()
        if(EXISTS "${F}" OR IS_SYMLINK "${F}")
          file(REMOVE "${F}")
          math(EXPR COUNT "${COUNT} + 1")
        endif()
        get_filename_component(D "${F}" DIRECTORY)
        while(NOT "${D}" STREQUAL "${CL_PREFIX}" AND NOT "${D}" STREQUAL "")
          list(APPEND DIRS "${D}")
          get_filename_component(D "${D}" DIRECTORY)
        endwhile()
      endforeach()
      _cl_prune_empty_dirs("${DIRS}")
      _cl_manifest_files_path("${A_name}" LIST_FILE)
      file(REMOVE "${LIST_FILE}")
      _cl_key_label("${A_name}" A_label)
      _cl_info("${A_label}: removed (${COUNT} files)")
    endif()
    _cl_manifest_remove("${A_name}")
    _cl_manifest_save()

  else()
    _cl_die("internal error: unknown apply operation '${A_op}'")
  endif()
endfunction()

function(_cl_probe_problem NAME RP)
  if(${RP}_CLASS STREQUAL "norecipe")
    _cl_die("no recipe for '${NAME}'. Add a recipe repository with --repo or a single recipe with --recipe ${NAME}=<file>.\n${${RP}_OUT}")
  elseif(${RP}_CLASS STREQUAL "nocompiler")
    _cl_die("no C compiler found for this target. Install one, or pass a toolchain with --toolchain.")
  elseif(${RP}_CLASS STREQUAL "error")
    _cl_warn("${NAME}: probe failed, continuing:\n${${RP}_OUT}")
  endif()
endfunction()

function(_cl_manifest_source NAME SOURCE OUT)
  if("${SOURCE}" STREQUAL "${NAME}")
    set(${OUT} "" PARENT_SCOPE)
  else()
    set(${OUT} "${SOURCE}" PARENT_SCOPE)
  endif()
endfunction()

function(_cl_record_found NAME KIND SPEC TYPE SOURCE RP OUT)
  if(${RP}_stage STREQUAL "toolchain")
    set(WHO "toolchain")
    set(STAGE "toolchain")
  else()
    set(WHO "system")
    set(STAGE "system")
  endif()
  _cl_manifest_source("${NAME}" "${SOURCE}" MSRC)
  _cl_manifest_key("${NAME}" "${KIND}" KEY)
  _cl_label("${NAME}" "${KIND}" LABEL)
  _cl_kind_name("${KIND}" KIND_NAME)
  _cl_commit(DONE put "${KEY}" MANAGED_BY "${WHO}" STAGE "${STAGE}" REQUESTED "${SPEC}" TYPE "${TYPE}" SOURCE "${MSRC}" KIND "${KIND_NAME}" VERSION "${${RP}_version}")
  if(DONE)
    _cl_info("${LABEL}: found (${WHO}-managed), nothing to install")
  else()
    _cl_warn("${LABEL}: could not record it in ${CL_PREFIX}")
  endif()
  set(${OUT} ${DONE} PARENT_SCOPE)
endfunction()

function(_cl_kind_name KIND OUT)
  if(KIND STREQUAL "exe")
    set(${OUT} "application" PARENT_SCOPE)
  else()
    set(${OUT} "library" PARENT_SCOPE)
  endif()
endfunction()

function(_cl_manifest_match NAME OUT)
  _cl_manifest_names(KEYS)
  string(TOLOWER "${NAME}" WANTED)
  set(CANDIDATES "")
  foreach(KEY ${KEYS})
    _cl_key_split("${KEY}" N K)
    if(N STREQUAL NAME)
      set(${OUT} "${NAME}" PARENT_SCOPE)
      return()
    endif()
    string(TOLOWER "${N}" N_LOWER)
    if(N_LOWER STREQUAL WANTED)
      list(APPEND CANDIDATES "${N}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES CANDIDATES)
  list(LENGTH CANDIDATES COUNT)
  if(COUNT GREATER 1)
    string(REPLACE ";" ", " TEXT "${CANDIDATES}")
    _cl_die("'${NAME}' is ambiguous: the manifest has ${TEXT} (use the exact spelling)")
  endif()
  set(${OUT} "${CANDIDATES}" PARENT_SCOPE)
endfunction()

function(_cl_canonical_name NAME_VAR SOURCE_VAR KINDS_VAR)
  set(NAME "${${NAME_VAR}}")
  set(SOURCE "${${SOURCE_VAR}}")
  set(RENAME FALSE)
  if("${SOURCE}" STREQUAL "${NAME}")
    set(RENAME TRUE)
  endif()

  set(CANON "")
  if(RENAME)
    _cl_manifest_match("${NAME}" CANON)
  endif()
  set(PROBE_NAME "${NAME}")
  if(NOT "${CANON}" STREQUAL "")
    set(PROBE_NAME "${CANON}")
  endif()

  _cl_probe(resolve "${PROBE_NAME}" R SOURCE "${SOURCE}")
  if(RENAME AND "${CANON}" STREQUAL "")
    if(R_state STREQUAL "resolved" AND NOT "${R_name}" STREQUAL "")
      set(CANON "${R_name}")
    elseif(R_OUT MATCHES "is ambiguous")
      string(REGEX MATCH "Package name[^\n]*\n?[^\n]*" MSG "${R_OUT}")
      _cl_die("${MSG}")
    endif()
  endif()
  if("${CANON}" STREQUAL "")
    set(CANON "${NAME}")
  endif()

  if(RENAME AND NOT CANON STREQUAL NAME)
    _cl_info("${NAME}: using the recipe registered as '${CANON}'")
    set(${NAME_VAR} "${CANON}" PARENT_SCOPE)
    set(${SOURCE_VAR} "${CANON}" PARENT_SCOPE)
  endif()
  set(${KINDS_VAR} "${R_kinds}" PARENT_SCOPE)
  foreach(K official lib_origin lib_path lib_file exe_origin exe_path exe_file)
    set(CL_RECIPE_${K} "${R_${K}}" PARENT_SCOPE)
  endforeach()
endfunction()

function(_cl_review_recipe NAME KIND)
  set(ORIGIN "${CL_RECIPE_${KIND}_origin}")
  set(FILE "${CL_RECIPE_${KIND}_file}")
  if("${FILE}" STREQUAL "" OR ("${ORIGIN}" STREQUAL "${CL_RECIPE_official}" AND NOT "${ORIGIN}" STREQUAL ""))
    return()
  endif()

  _cl_label("${NAME}" "${KIND}" LABEL)
  if(ORIGIN STREQUAL "direct")
    set(WHERE "${CL_RECIPE_${KIND}_path}")
  else()
    set(WHERE "the repository ${ORIGIN} (${CL_RECIPE_${KIND}_path})")
  endif()

  if(CL_OPT_YES)
    _cl_info("${LABEL}: using the recipe from ${WHERE}, which is not in the official repo")
    return()
  endif()

  file(READ "${FILE}" CONTENT)
  _cl_info("${LABEL}: this recipe is not in the official repo and runs as CMake code on this machine.\n"
           "  from: ${WHERE}\n"
           "----------------------------------------\n${CONTENT}\n----------------------------------------")

  _cl_is_noninteractive(NI)
  _cl_has_tty(TTY)
  if(NI OR NOT TTY)
    _cl_info("${LABEL}: not asking (non-interactive session), continuing with this recipe")
    return()
  endif()
  _cl_confirm("run the recipe for ${LABEL}?" OK DEFAULT_YES)
  if(NOT OK)
    _cl_die("${LABEL}: not running the recipe")
  endif()
endfunction()

function(_cl_select_kinds NAME AVAILABLE OUT)
  set(WANTED "")
  if(CL_OPT_LIB)
    list(APPEND WANTED lib)
  endif()
  if(CL_OPT_EXE)
    list(APPEND WANTED exe)
  endif()

  if(WANTED)
    if(NOT "${AVAILABLE}" STREQUAL "")
      foreach(K ${WANTED})
        if(NOT "${K}:specific" IN_LIST AVAILABLE AND NOT "${K}:generic" IN_LIST AVAILABLE)
          if(K STREQUAL "exe")
            _cl_die("${NAME} has no application recipe (it would be recipe-exe.cmake, or ${NAME}/exe in a repository)")
          else()
            _cl_die("${NAME} has no library recipe (it would be recipe-lib.cmake, or ${NAME}/lib in a repository)")
          endif()
        endif()
      endforeach()
    endif()
    set(${OUT} "${WANTED}" PARENT_SCOPE)
    return()
  endif()

  set(OTHER_THAN_EXE FALSE)
  if("lib:specific" IN_LIST AVAILABLE OR "lib:generic" IN_LIST AVAILABLE)
    set(OTHER_THAN_EXE TRUE)
  endif()
  if("exe:specific" IN_LIST AVAILABLE)
    if(OTHER_THAN_EXE)
      if("ALLOW_BOTH" IN_LIST ARGN)
        set(${OUT} "lib;exe" PARENT_SCOPE)
        return()
      endif()
      _cl_die("${NAME} has a library and an application recipe: pass --lib, --exe, or both")
    endif()
    set(${OUT} "exe" PARENT_SCOPE)
    return()
  endif()
  set(${OUT} "lib" PARENT_SCOPE)
endfunction()

function(_cl_install_staged STAGE NAME KIND SPEC SOURCE OUT)
  _cl_manifest_key("${NAME}" "${KIND}" KEY)
  _cl_label("${NAME}" "${KIND}" LABEL)
  _cl_kind_name("${KIND}" KIND_NAME)
  _cl_manifest_source("${NAME}" "${SOURCE}" MSRC)
  set(${OUT} failed PARENT_SCOPE)
  set(TYPE "${CL_OPT_TYPE}")
  if(KIND STREQUAL "exe")
    set(TYPE "")
  endif()

  set(STAGE_DIR "")
  if(CL_ELEVATE)
    string(RANDOM LENGTH 6 ALPHABET "0123456789abcdef" RND)
    set(STAGE_DIR "${CL_WORK}/stage-${NAME}-${RND}")
    file(MAKE_DIRECTORY "${STAGE_DIR}")
  endif()

  if(STAGE STREQUAL "source")
    _cl_info("${LABEL}: building from source into ${CL_PREFIX}")
    _cl_probe(source "${NAME}" S SPEC "${SPEC}" TYPE "${TYPE}" SOURCE "${SOURCE}" STAGE_DIR "${STAGE_DIR}" PKG_KIND "${KIND}" STREAM)
  else()
    _cl_info("${LABEL}: looking for a prebuilt binary...")
    _cl_probe(prebuilt "${NAME}" S SPEC "${SPEC}" TYPE "${TYPE}" SOURCE "${SOURCE}" STAGE_DIR "${STAGE_DIR}" PKG_KIND "${KIND}")
  endif()

  if(NOT S_RC EQUAL 0 OR NOT S_state STREQUAL "resolved")
    _cl_remove_stage("${STAGE_DIR}")
    if(STAGE STREQUAL "source")
      _cl_warn("${LABEL}: could not be installed (see the output above)")
    else()
      if(S_CLASS STREQUAL "error")
        _cl_warn("${LABEL}: the prebuilt install failed, trying a source build:\n${S_OUT}")
      else()
        _cl_verbose("${LABEL}: no prebuilt binary for this target")
      endif()
      set(${OUT} skipped PARENT_SCOPE)
    endif()
    return()
  endif()
  if("${S_files}" STREQUAL "")
    _cl_remove_stage("${STAGE_DIR}")
    if(STAGE STREQUAL "source")
      _cl_warn("${LABEL}: the build succeeded but installed no files. The project may not define install rules, "
               "the recipe may switch them off (see INSTALL_OPTIONS), or its _recipe_${NAME}_install function "
               "may not use install_files(), which is what records files for the manifest.")
    else()
      _cl_warn("${LABEL}: the prebuilt install put no files in the prefix (does _recipe_${NAME}_install use install_files()?), trying a source build")
      set(${OUT} skipped PARENT_SCOPE)
    endif()
    return()
  endif()

  _cl_commit(DONE put "${KEY}" MANAGED_BY catalog STAGE "${STAGE}" REQUESTED "${SPEC}" TYPE "${TYPE}"
             SOURCE "${MSRC}" STAGE_DIR "${STAGE_DIR}" KIND "${KIND_NAME}" VERSION "${S_version}" FILES ${S_files})
  _cl_remove_stage("${STAGE_DIR}")
  if(NOT DONE)
    _cl_warn("${LABEL}: installed, but could not be put into ${CL_PREFIX}")
    return()
  endif()
  list(LENGTH S_files N)
  _cl_info("${LABEL}: installed from ${STAGE} (${N} files)")
  set(${OUT} installed PARENT_SCOPE)
endfunction()

function(_cl_install_one NAME KIND SPEC SOURCE OUT)
  _cl_manifest_source("${NAME}" "${SOURCE}" MSRC)
  _cl_manifest_key("${NAME}" "${KIND}" KEY)
  _cl_label("${NAME}" "${KIND}" LABEL)
  _cl_kind_name("${KIND}" KIND_NAME)
  set(${OUT} FALSE PARENT_SCOPE)
  set(TYPE "${CL_OPT_TYPE}")
  if(KIND STREQUAL "exe")
    set(TYPE "")
  endif()

  _cl_manifest_has("${KEY}" HAS)
  set(WHO "")
  if(HAS)
    _cl_manifest_field("${KEY}" managed_by WHO)
    if(NOT CL_OPT_FORCE)
      _cl_info("${LABEL}: already installed (managed by ${WHO}); use --force to redo")
      set(${OUT} TRUE PARENT_SCOPE)
      return()
    endif()
  endif()

  if(NOT CL_OPT_SOURCE AND NOT WHO STREQUAL "catalog")
    _cl_info("${LABEL}: looking for an existing installation...")
    _cl_probe(detect "${NAME}" D SPEC "${SPEC}" TYPE "${TYPE}" SOURCE "${SOURCE}" PKG_KIND "${KIND}")
    if(D_CLASS STREQUAL "ok" AND D_state STREQUAL "resolved")
      if(CL_OPT_DRY_RUN)
        _cl_info("${LABEL}: [dry-run] found on the ${D_stage}, would record it (nothing to install)")
        set(${OUT} TRUE PARENT_SCOPE)
        return()
      endif()
      _cl_record_found("${NAME}" "${KIND}" "${SPEC}" "${TYPE}" "${SOURCE}" D RECORDED)
      set(${OUT} ${RECORDED} PARENT_SCOPE)
      return()
    endif()
    _cl_probe_problem("${NAME}" D)
  endif()

  if(NOT CL_OPT_SOURCE AND NOT WHO STREQUAL "catalog")
    set(PM_OK TRUE)
    if(CL_CROSS AND NOT CL_DEVKITPRO)
      _cl_info("${LABEL}: skipping the package manager (cross-compiling: it would install for the host, not the target)")
      set(PM_OK FALSE)
    endif()

    if(PM_OK)
      _cl_probe(package "${NAME}" P SPEC "${SPEC}" TYPE "${TYPE}" SOURCE "${SOURCE}" PKG_KIND "${KIND}")
      if(P_state STREQUAL "queried" AND NOT "${P_pm}" STREQUAL "" AND NOT "${P_name}" STREQUAL "")
        _catalog_package_install_command("${P_pm}" "${P_name}" PM_CMD)
        if("${PM_CMD}" STREQUAL "")
          _cl_verbose("${LABEL}: package manager '${P_pm}' is not supported")
        else()
          set(APPROVED FALSE)
          if(CL_OPT_DRY_RUN)
            _cl_is_noninteractive(NI)
            if(CL_OPT_YES OR NOT NI)
              _cl_info("${LABEL}: [dry-run] would install '${P_name}' with ${P_pm}: ${PM_CMD}")
              set(${OUT} TRUE PARENT_SCOPE)
              return()
            endif()
            _cl_info("${LABEL}: [dry-run] package '${P_name}' is available through ${P_pm}, but this is a non-interactive session (use --yes to allow it)")
          elseif(CL_OPT_YES)
            set(APPROVED TRUE)
          else()
            _cl_is_noninteractive(NI)
            if(NI)
              _cl_info("${LABEL}: package '${P_name}' is available through ${P_pm}, but this is a non-interactive session (use --yes to allow it)")
            else()
              _cl_confirm("install '${P_name}' with ${P_pm}?" APPROVED)
            endif()
          endif()

          if(APPROVED)
            _cl_info("${LABEL}: installing '${P_name}' with ${P_pm} (through doas/sudo unless you are root)")
            execute_process(COMMAND sh -c "${PM_CMD}" RESULT_VARIABLE PM_RC)
            if(PM_RC EQUAL 0)
              _cl_probe(detect "${NAME}" D2 SPEC "${SPEC}" TYPE "${TYPE}" SOURCE "${SOURCE}" PKG_KIND "${KIND}")
              if(D2_CLASS STREQUAL "ok" AND D2_state STREQUAL "resolved")
                _cl_commit(DONE put "${KEY}" MANAGED_BY package-manager STAGE package REQUESTED "${SPEC}"
                           TYPE "${TYPE}" PACKAGE_MANAGER "${P_pm}" PACKAGE_NAME "${P_name}" SOURCE "${MSRC}" KIND "${KIND_NAME}" VERSION "${D2_version}")
                if(DONE)
                  _cl_info("${LABEL}: installed with ${P_pm} (${P_name})")
                else()
                  _cl_warn("${LABEL}: installed with ${P_pm}, but could not record it in ${CL_PREFIX}")
                endif()
                set(${OUT} ${DONE} PARENT_SCOPE)
                return()
              endif()
              _cl_warn("${LABEL}: ${P_pm} installed '${P_name}' but it does not satisfy the requirement; trying the next option")
            else()
              _cl_warn("${LABEL}: package manager failed (exit ${PM_RC}); trying the next option")
            endif()
          endif()
        endif()
      endif()
    endif()
  endif()

  set(TRY_PREBUILT TRUE)
  if(CL_OPT_SOURCE OR CL_OPT_NO_PREBUILT)
    set(TRY_PREBUILT FALSE)
  endif()

  if(CL_OPT_DRY_RUN)
    if(TRY_PREBUILT)
      _cl_info("${LABEL}: [dry-run] would use a prebuilt binary if the recipe has one for this target, else build from source into ${CL_PREFIX}")
    else()
      _cl_info("${LABEL}: [dry-run] would build from source into ${CL_PREFIX}")
    endif()
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()

  if(TRY_PREBUILT)
    _cl_install_staged(prebuilt "${NAME}" "${KIND}" "${SPEC}" "${SOURCE}" RESULT)
    if(RESULT STREQUAL "installed")
      set(${OUT} TRUE PARENT_SCOPE)
      return()
    elseif(RESULT STREQUAL "failed")
      return()
    endif()
  endif()

  _cl_install_staged(source "${NAME}" "${KIND}" "${SPEC}" "${SOURCE}" RESULT)
  if(RESULT STREQUAL "installed")
    set(${OUT} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(_cl_cmd_install)
  if(NOT CL_PKGS)
    _cl_die("install: no packages given (see `catalog help`)")
  endif()
  _cl_describe_target()
  if(NOT CL_OPT_DRY_RUN)
    _cl_begin_mutation()
  endif()

  set(FAILED "")
  foreach(ARG ${CL_PKGS})
    _cl_split_package_arg("${ARG}" NAME SPEC SOURCE)
    _cl_canonical_name(NAME SOURCE AVAILABLE)
    _cl_select_kinds("${NAME}" "${AVAILABLE}" KINDS)
    foreach(KIND ${KINDS})
      _cl_review_recipe("${NAME}" "${KIND}")
      _cl_install_one("${NAME}" "${KIND}" "${SPEC}" "${SOURCE}" OK)
      if(NOT OK)
        _cl_label("${NAME}" "${KIND}" LABEL)
        list(APPEND FAILED "${LABEL}")
      endif()
    endforeach()
  endforeach()
  if(FAILED)
    string(REPLACE ";" ", " TEXT "${FAILED}")
    _cl_die("failed to install: ${TEXT}")
  endif()
endfunction()

function(_cl_prune_empty_dirs DIRS)
  list(REMOVE_DUPLICATES DIRS)
  list(SORT DIRS)
  list(REVERSE DIRS)
  foreach(D ${DIRS})
    if(NOT IS_DIRECTORY "${D}" OR "${D}" STREQUAL "${CL_PREFIX}")
      continue()
    endif()
    get_filename_component(PARENT "${D}" DIRECTORY)
    if(PARENT STREQUAL "${CL_PREFIX}")
      continue()
    endif()
    file(GLOB CHILDREN LIST_DIRECTORIES true "${D}/*" "${D}/.[!.]*")
    if(NOT CHILDREN)
      file(REMOVE_RECURSE "${D}")
    endif()
  endforeach()
endfunction()

function(_cl_remove_one NAME KIND)
  _cl_manifest_key("${NAME}" "${KIND}" KEY)
  _cl_label("${NAME}" "${KIND}" LABEL)
  _cl_manifest_has("${KEY}" HAS)
  if(NOT HAS)
    _cl_warn("${LABEL}: not in the manifest, nothing to do")
    return()
  endif()

  _cl_manifest_field("${KEY}" managed_by WHO)
  if(CL_OPT_DRY_RUN)
    if(WHO STREQUAL "catalog")
      _cl_manifest_read_files("${KEY}" FILES)
      list(LENGTH FILES N)
      _cl_info("${LABEL}: [dry-run] would remove ${N} files from ${CL_PREFIX} and drop it from the manifest")
    else()
      _cl_info("${LABEL}: [dry-run] would forget it (${WHO}-managed, nothing is uninstalled)")
    endif()
    return()
  endif()
  if(WHO STREQUAL "package-manager")
    _cl_manifest_field("${KEY}" package_manager PM)
    _cl_manifest_field("${KEY}" package_name PKG)
    _cl_info("${LABEL}: forgotten. It was installed with ${PM} ('${PKG}'); Catalog does not uninstall packages from the package manager.")
  elseif(NOT WHO STREQUAL "catalog")
    _cl_info("${LABEL}: forgotten. It is ${WHO}-managed, so nothing was uninstalled.")
  endif()
  _cl_commit(DONE remove "${KEY}")
  if(NOT DONE)
    _cl_die("${LABEL}: could not be removed from ${CL_PREFIX}")
  endif()
endfunction()

function(_cl_cmd_remove)
  if(NOT CL_PKGS)
    _cl_die("remove: no packages given")
  endif()
  if(NOT CL_OPT_DRY_RUN)
    _cl_begin_mutation()
  endif()
  foreach(ARG ${CL_PKGS})
    _cl_split_package_arg("${ARG}" NAME SPEC SOURCE)
    _cl_manifest_match("${NAME}" MATCHED)
    if(NOT "${MATCHED}" STREQUAL "")
      set(NAME "${MATCHED}")
    endif()

    set(KINDS "")
    if(CL_OPT_LIB)
      list(APPEND KINDS lib)
    endif()
    if(CL_OPT_EXE)
      list(APPEND KINDS exe)
    endif()
    if(NOT KINDS)
      _cl_manifest_has("${NAME}" HAS_LIB)
      _cl_manifest_has("${NAME}#exe" HAS_EXE)
      if(HAS_LIB AND HAS_EXE)
        _cl_die("${NAME} is installed as a library and as an application: pass --lib, --exe, or both")
      elseif(HAS_EXE)
        set(KINDS exe)
      else()
        set(KINDS lib)
      endif()
    endif()
    foreach(KIND ${KINDS})
      _cl_remove_one("${NAME}" "${KIND}")
    endforeach()
  endforeach()
endfunction()

function(_cl_cmd_list)
  if(CL_OPT_JSON)
    _cl_manifest_json(JSON)
    _cl_say("${JSON}")
    return()
  endif()

  _cl_describe_target()
  _cl_manifest_names(KEYS)
  if(NOT KEYS)
    _cl_info("no packages recorded")
    return()
  endif()

  _cl_pad("NAME" 24 C1)
  _cl_pad("KIND" 6 C2)
  _cl_pad("VERSION" 14 C5)
  _cl_pad("MANAGED BY" 17 C3)
  _cl_pad("STAGE" 10 C4)
  set(TEXT "${C1}${C2}${C5}${C3}${C4}REQUESTED")
  foreach(KEY ${KEYS})
    _cl_key_split("${KEY}" N K)
    _cl_manifest_field("${KEY}" managed_by WHO)
    _cl_manifest_field("${KEY}" stage STAGE)
    _cl_manifest_field("${KEY}" requested REQ)
    _cl_manifest_field("${KEY}" type TYPE)
    _cl_manifest_field("${KEY}" version VER)
    if("${VER}" STREQUAL "")
      set(VER "unknown")
    endif()
    set(EXTRA "${REQ}")
    if(NOT "${TYPE}" STREQUAL "")
      string(STRIP "${EXTRA} ${TYPE}" EXTRA)
    endif()
    _cl_pad("${VER}" 14 C5)
    _cl_pad("${N}" 24 C1)
    _cl_pad("${K}" 6 C2)
    _cl_pad("${WHO}" 17 C3)
    _cl_pad("${STAGE}" 10 C4)
    set(TEXT "${TEXT}\n${C1}${C2}${C5}${C3}${C4}${EXTRA}")
  endforeach()
  _cl_say("${TEXT}")
endfunction()

function(_cl_cmd_check)
  if(NOT CL_PKGS)
    _cl_die("check: no packages given")
  endif()
  set(MISSING FALSE)
  foreach(ARG ${CL_PKGS})
    _cl_split_package_arg("${ARG}" NAME SPEC SOURCE)
    _cl_canonical_name(NAME SOURCE AVAILABLE)
    _cl_select_kinds("${NAME}" "${AVAILABLE}" KINDS ALLOW_BOTH)
    foreach(KIND ${KINDS})
      _cl_manifest_key("${NAME}" "${KIND}" KEY)
      _cl_label("${NAME}" "${KIND}" LABEL)
      _cl_manifest_has("${KEY}" HAS)
      if(HAS)
        _cl_manifest_field("${KEY}" managed_by WHO)
        _cl_say("${LABEL}: installed (${WHO})")
        continue()
      endif()
      _cl_review_recipe("${NAME}" "${KIND}")
      set(TYPE "${CL_OPT_TYPE}")
      if(KIND STREQUAL "exe")
        set(TYPE "")
      endif()
      _cl_probe(detect "${NAME}" D SPEC "${SPEC}" TYPE "${TYPE}" SOURCE "${SOURCE}" PKG_KIND "${KIND}")
      if(D_CLASS STREQUAL "ok" AND D_state STREQUAL "resolved")
        if(D_stage STREQUAL "toolchain")
          _cl_say("${LABEL}: available (toolchain)")
        else()
          _cl_say("${LABEL}: available (system)")
        endif()
      else()
        _cl_probe_problem("${NAME}" D)
        _cl_say("${LABEL}: not found")
        set(MISSING TRUE)
      endif()
    endforeach()
  endforeach()
  if(MISSING)
    _cl_exit(1)
  endif()
endfunction()

function(_cl_cmd_search)
  if(CL_OPT_INTERACTIVE)
    find_program(_CL_FZF fzf)
    if(NOT _CL_FZF)
      _cl_die("--interactive needs fzf, which was not found in PATH")
    endif()
  endif()

  _cl_probe(list "all" L)
  if(NOT L_state STREQUAL "listed")
    _cl_probe_problem("recipes" L)
    _cl_die("could not list recipes (no recipe repository loaded? see --repo)")
  endif()

  set(NAMES "")
  foreach(KEY ${L_recipes})
    set(N "${KEY}")
    set(K "")
    if(KEY MATCHES "^(.*)/(lib|exe)$")
      set(N "${CMAKE_MATCH_1}")
      set(K "${CMAKE_MATCH_2}")
    endif()
    if(CL_OPT_LIB OR CL_OPT_EXE)
      set(KEEP FALSE)
      if(CL_OPT_LIB AND (K STREQUAL "" OR K STREQUAL "lib"))
        set(KEEP TRUE)
      endif()
      if(CL_OPT_EXE AND K STREQUAL "exe")
        set(KEEP TRUE)
      endif()
      if(NOT KEEP)
        continue()
      endif()
    endif()
    list(APPEND NAMES "${N}")
  endforeach()
  list(REMOVE_DUPLICATES NAMES)
  list(SORT NAMES CASE INSENSITIVE)

  if(CL_OPT_INTERACTIVE)
    string(RANDOM LENGTH 6 ALPHABET "0123456789abcdef" RND)
    set(INPUT "${CL_WORK}/search-${RND}.txt")
    string(REPLACE ";" "\n" LINES "${NAMES}")
    file(WRITE "${INPUT}" "${LINES}\n")
    string(REPLACE ";" " " QUERY "${CL_PKGS}")
    execute_process(COMMAND "${_CL_FZF}" --multi --prompt "recipe> " --query "${QUERY}"
                    INPUT_FILE "${INPUT}" OUTPUT_VARIABLE PICKED RESULT_VARIABLE RC)
    file(REMOVE "${INPUT}")
    if(NOT RC EQUAL 0)
      _cl_exit(1)
    endif()
    string(STRIP "${PICKED}" PICKED)
    _cl_say("${PICKED}")
    return()
  endif()

  set(MATCHES "")
  foreach(N ${NAMES})
    if(NOT CL_PKGS)
      list(APPEND MATCHES "${N}")
      continue()
    endif()
    foreach(TERM ${CL_PKGS})
      string(TOLOWER "${N}" N_LOWER)
      string(TOLOWER "${TERM}" T_LOWER)
      string(FIND "${N_LOWER}" "${T_LOWER}" POS)
      if(NOT POS EQUAL -1)
        list(APPEND MATCHES "${N}")
        break()
      endif()
    endforeach()
  endforeach()

  if(NOT MATCHES)
    _cl_info("no recipes match")
    _cl_exit(1)
  endif()
  string(REPLACE ";" "\n" TEXT "${MATCHES}")
  _cl_say("${TEXT}")
endfunction()

function(_cl_cmd_clean)
  if(CL_OPT_ALL)
    file(GLOB DIRS LIST_DIRECTORIES true "${CL_HOME}/cache/*")
  else()
    set(DIRS "${CL_CACHE}")
  endif()

  set(COUNT 0)
  foreach(D ${DIRS})
    if(NOT IS_DIRECTORY "${D}")
      continue()
    endif()
    file(GLOB ENTRIES LIST_DIRECTORIES true "${D}/*" "${D}/.[!.]*")
    list(LENGTH ENTRIES N)
    math(EXPR COUNT "${COUNT} + ${N}")
    _cl_verbose("${D}: ${N} entries")
    if(NOT CL_OPT_DRY_RUN)
      foreach(E ${ENTRIES})
        file(REMOVE_RECURSE "${E}")
      endforeach()
    endif()
  endforeach()

  if(CL_OPT_DRY_RUN)
    _cl_info("[dry-run] would delete ${COUNT} cache entries")
  else()
    _cl_info("deleted ${COUNT} cache entries")
  endif()
endfunction()

function(_cl_target_keys OUT)
  _cl_manifest_names(ALL)
  set(KEYS "")
  if(NOT CL_PKGS)
    set(KEYS ${ALL})
  else()
    foreach(ARG ${CL_PKGS})
      _cl_split_package_arg("${ARG}" NAME SPEC SOURCE)
      _cl_manifest_match("${NAME}" MATCHED)
      if(NOT "${MATCHED}" STREQUAL "")
        set(NAME "${MATCHED}")
      endif()
      set(FOUND FALSE)
      foreach(KIND lib exe)
        _cl_manifest_key("${NAME}" "${KIND}" KEY)
        if(NOT KEY IN_LIST ALL)
          continue()
        endif()
        if((CL_OPT_LIB OR CL_OPT_EXE) AND NOT ((KIND STREQUAL "lib" AND CL_OPT_LIB) OR (KIND STREQUAL "exe" AND CL_OPT_EXE)))
          continue()
        endif()
        list(APPEND KEYS "${KEY}")
        set(FOUND TRUE)
      endforeach()
      if(NOT FOUND)
        _cl_warn("${NAME}: not in the manifest, nothing to do")
      endif()
    endforeach()
  endif()
  set(${OUT} "${KEYS}" PARENT_SCOPE)
endfunction()

# Compares what the manifest recorded for KEY with what its recipe installs today.
# STATUS_VAR is one of: foreign (not installed by Catalog), norecipe, unknown (the recipe
# does not say), unrecorded (the install did not record a version), current, outdated.
function(_cl_version_status KEY STATUS_VAR INSTALLED_VAR LATEST_VAR)
  _cl_key_split("${KEY}" NAME KIND)
  _cl_manifest_field("${KEY}" managed_by WHO)
  _cl_manifest_field("${KEY}" version INSTALLED)
  _cl_manifest_field("${KEY}" source SOURCE)
  _cl_manifest_field("${KEY}" requested SPEC)
  _cl_manifest_field("${KEY}" type TYPE)
  if("${INSTALLED}" STREQUAL "")
    set(INSTALLED "unknown")
  endif()
  set(${INSTALLED_VAR} "${INSTALLED}" PARENT_SCOPE)
  set(${LATEST_VAR} "" PARENT_SCOPE)

  if(NOT WHO STREQUAL "catalog")
    set(${STATUS_VAR} foreign PARENT_SCOPE)
    return()
  endif()

  if("${SOURCE}" STREQUAL "")
    set(SOURCE "${NAME}")
  endif()
  _cl_canonical_name(NAME SOURCE AVAILABLE)
  if(NOT "${KIND}:specific" IN_LIST AVAILABLE AND NOT "${KIND}:generic" IN_LIST AVAILABLE)
    set(${STATUS_VAR} norecipe PARENT_SCOPE)
    return()
  endif()
  _cl_review_recipe("${NAME}" "${KIND}")

  _cl_probe(latest "${NAME}" L SPEC "${SPEC}" TYPE "${TYPE}" SOURCE "${SOURCE}" PKG_KIND "${KIND}")
  if(NOT L_CLASS STREQUAL "ok" OR NOT L_state STREQUAL "latest" OR "${L_version}" STREQUAL "")
    set(${STATUS_VAR} unknown PARENT_SCOPE)
    return()
  endif()
  set(${LATEST_VAR} "${L_version}" PARENT_SCOPE)

  if(INSTALLED STREQUAL "unknown")
    set(${STATUS_VAR} unrecorded PARENT_SCOPE)
    return()
  endif()
  _catalog_compare_versions("${L_version}" ">" "${INSTALLED}" NEWER)
  if(NEWER)
    set(${STATUS_VAR} outdated PARENT_SCOPE)
  else()
    set(${STATUS_VAR} current PARENT_SCOPE)
  endif()
endfunction()

function(_cl_cmd_outdated)
  _cl_describe_target()
  _cl_target_keys(KEYS)
  if(NOT KEYS)
    _cl_info("no packages recorded")
    return()
  endif()

  _cl_pad("NAME" 24 C1)
  _cl_pad("KIND" 6 C2)
  _cl_pad("INSTALLED" 14 C3)
  _cl_pad("LATEST" 14 C4)
  set(TEXT "${C1}${C2}${C3}${C4}STATUS")
  foreach(KEY ${KEYS})
    _cl_key_split("${KEY}" N K)
    _cl_version_status("${KEY}" STATUS INSTALLED LATEST)
    if("${LATEST}" STREQUAL "")
      set(LATEST "-")
    endif()
    if(STATUS STREQUAL "foreign")
      _cl_manifest_field("${KEY}" managed_by WHO)
      set(NOTE "not updated by catalog (${WHO}-managed)")
    elseif(STATUS STREQUAL "norecipe")
      set(NOTE "no recipe (pass --repo / --recipe?)")
    elseif(STATUS STREQUAL "unknown")
      set(NOTE "unknown (the recipe does not say)")
    elseif(STATUS STREQUAL "unrecorded")
      set(NOTE "outdated? (no version was recorded)")
    elseif(STATUS STREQUAL "outdated")
      set(NOTE "outdated")
    else()
      set(NOTE "up to date")
    endif()
    _cl_pad("${N}" 24 C1)
    _cl_pad("${K}" 6 C2)
    _cl_pad("${INSTALLED}" 14 C3)
    _cl_pad("${LATEST}" 14 C4)
    set(TEXT "${TEXT}\n${C1}${C2}${C3}${C4}${NOTE}")
  endforeach()
  _cl_say("${TEXT}")
endfunction()

function(_cl_cmd_update)
  _cl_describe_target()
  _cl_target_keys(KEYS)
  if(NOT KEYS)
    _cl_info("no packages recorded")
    return()
  endif()
  if(NOT CL_OPT_DRY_RUN)
    _cl_begin_mutation()
  endif()

  set(FAILED "")
  foreach(KEY ${KEYS})
    _cl_key_split("${KEY}" NAME KIND)
    _cl_key_label("${KEY}" LABEL)
    _cl_version_status("${KEY}" STATUS INSTALLED LATEST)

    if(STATUS STREQUAL "foreign")
      _cl_manifest_field("${KEY}" managed_by WHO)
      _cl_info("${LABEL}: not updated, it is ${WHO}-managed (use your package manager or system for that)")
      continue()
    elseif(STATUS STREQUAL "norecipe")
      _cl_info("${LABEL}: not updated, there is no recipe for it (pass --repo / --recipe?)")
      continue()
    elseif(STATUS STREQUAL "current")
      _cl_info("${LABEL}: up to date (${INSTALLED})")
      continue()
    elseif(STATUS STREQUAL "unknown" AND NOT CL_OPT_FORCE)
      _cl_info("${LABEL}: the recipe does not say what the latest version is (installed: ${INSTALLED}), use --force to reinstall it anyway")
      continue()
    endif()

    if(CL_OPT_DRY_RUN)
      _cl_info("${LABEL}: [dry-run] would update ${INSTALLED} -> ${LATEST}")
      continue()
    endif()

    _cl_manifest_field("${KEY}" source SOURCE)
    _cl_manifest_field("${KEY}" requested SPEC)
    _cl_manifest_field("${KEY}" type TYPE)
    if("${SOURCE}" STREQUAL "")
      set(SOURCE "${NAME}")
    endif()
    set(CL_OPT_FORCE TRUE)
    set(CL_OPT_TYPE "${TYPE}")
    _cl_info("${LABEL}: updating ${INSTALLED} -> ${LATEST}")
    _cl_install_one("${NAME}" "${KIND}" "${SPEC}" "${SOURCE}" OK)
    if(NOT OK)
      list(APPEND FAILED "${LABEL}")
    endif()
  endforeach()
  if(FAILED)
    string(REPLACE ";" ", " TEXT "${FAILED}")
    _cl_die("failed to update: ${TEXT}")
  endif()
endfunction()

function(_cl_cmd_env)
  _cl_pkgconfig_dirs(DIRS)
  if(CMAKE_HOST_WIN32)
    _cl_die("env: only POSIX shell output is implemented; use `catalog prefix` to build the variables yourself")
  endif()
  string(JOIN ":" PC ${DIRS})
  set(TEXT "export CATALOG_TARGET=\"${CL_TARGET_ID}\"\nexport CATALOG_PREFIX=\"${CL_PREFIX}\"")
  if(NOT CL_CROSS)
    set(TEXT "${TEXT}\nexport PATH=\"${CL_PREFIX}/bin\${PATH:+:\$PATH}\"")
  endif()
  set(TEXT "${TEXT}\nexport CMAKE_PREFIX_PATH=\"${CL_PREFIX}\${CMAKE_PREFIX_PATH:+:\$CMAKE_PREFIX_PATH}\"")
  if(CL_CROSS)
    set(TEXT "${TEXT}\nexport PKG_CONFIG_LIBDIR=\"${PC}\"\nexport PKG_CONFIG_PATH=\"${PC}\"")
  else()
    set(TEXT "${TEXT}\nexport PKG_CONFIG_PATH=\"${PC}\${PKG_CONFIG_PATH:+:\$PKG_CONFIG_PATH}\"")
  endif()
  if(NOT "${CL_TOOLCHAIN}" STREQUAL "")
    set(TEXT "${TEXT}\nexport CMAKE_TOOLCHAIN_FILE=\"${CL_TOOLCHAIN}\"")
  endif()
  _cl_say("${TEXT}")
endfunction()

function(_cl_cmd_prefix)
  _cl_say("${CL_PREFIX}")
endfunction()

function(_cl_main)
  _cl_parse_args(${ARGN})
  set(CL_VERBOSE "${CL_OPT_VERBOSE}")
  if(CL_VERBOSE)
    set(ENV{CATALOG_VERBOSE} 1)
  endif()

  if(CL_OPT_SHOW_VERSION OR CL_CMD STREQUAL "version")
    _cl_say("catalog ${CL_VERSION}")
    return()
  endif()
  if(CL_OPT_HELP OR CL_CMD STREQUAL "help" OR CL_CMD STREQUAL "")
    _cl_usage()
    if(CL_CMD STREQUAL "" AND NOT CL_OPT_HELP)
      _cl_exit(1)
    endif()
    return()
  endif()

  if(CL_CMD STREQUAL "completion")
    _cl_cmd_completion()
    return()
  endif()

  if(CL_CMD STREQUAL "__apply")
    list(GET CL_PKGS 0 APPLY_SPEC)
    _cl_apply_op("${APPLY_SPEC}")
    return()
  endif()

  if(CL_CMD STREQUAL "install" OR CL_CMD STREQUAL "add")
    set(RUN _cl_cmd_install)
  elseif(CL_CMD STREQUAL "remove" OR CL_CMD STREQUAL "uninstall" OR CL_CMD STREQUAL "rm")
    set(RUN _cl_cmd_remove)
  elseif(CL_CMD STREQUAL "list" OR CL_CMD STREQUAL "ls")
    set(RUN _cl_cmd_list)
  elseif(CL_CMD STREQUAL "check")
    set(RUN _cl_cmd_check)
  elseif(CL_CMD STREQUAL "outdated")
    set(RUN _cl_cmd_outdated)
  elseif(CL_CMD STREQUAL "update" OR CL_CMD STREQUAL "upgrade")
    set(RUN _cl_cmd_update)
  elseif(CL_CMD STREQUAL "search")
    set(RUN _cl_cmd_search)
  elseif(CL_CMD STREQUAL "clean")
    set(RUN _cl_cmd_clean)
  elseif(CL_CMD STREQUAL "env")
    set(RUN _cl_cmd_env)
  elseif(CL_CMD STREQUAL "prefix")
    set(RUN _cl_cmd_prefix)
  else()
    _cl_die("unknown command '${CL_CMD}' (see `catalog help`)")
  endif()

  _cl_setup_target()
  _cl_manifest_load()
  cmake_language(CALL ${RUN})
endfunction()
