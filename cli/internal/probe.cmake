function(_cl_home OUT)
  if(DEFINED ENV{CATALOG_HOME} AND NOT "$ENV{CATALOG_HOME}" STREQUAL "")
    set(HOME "$ENV{CATALOG_HOME}")
  elseif(CMAKE_HOST_WIN32)
    set(HOME "$ENV{LOCALAPPDATA}/catalog")
  elseif(DEFINED ENV{XDG_DATA_HOME} AND NOT "$ENV{XDG_DATA_HOME}" STREQUAL "")
    set(HOME "$ENV{XDG_DATA_HOME}/catalog")
  else()
    set(HOME "$ENV{HOME}/.local/share/catalog")
  endif()
  file(TO_CMAKE_PATH "${HOME}" HOME)
  set(${OUT} "${HOME}" PARENT_SCOPE)
endfunction()

function(_cl_cmake_quote VALUE OUT)
  if(VALUE MATCHES "\\]==\\]")
    _cl_die("unsupported character sequence in '${VALUE}'")
  endif()
  set(${OUT} "[==[${VALUE}]==]" PARENT_SCOPE)
endfunction()

function(_cl_kv_parse FILE PREFIX)
  if(NOT EXISTS "${FILE}")
    return()
  endif()
  file(STRINGS "${FILE}" LINES)
  foreach(LINE ${LINES})
    if(LINE MATCHES "^([a-z_]+)=(.*)$")
      set(${PREFIX}_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    endif()
  endforeach()
endfunction()

function(_cl_identify)
  string(RANDOM LENGTH 8 ALPHABET "0123456789abcdef" RND)
  set(DIR "${CL_HOME}/work/identify-${RND}")
  file(MAKE_DIRECTORY "${DIR}/src")
  _cl_cmake_quote("${CL_CORE_FILE}" Q_CORE)
  _cl_cmake_quote("${DIR}/result.txt" Q_RESULT)

  file(WRITE "${DIR}/src/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)
project(catalog_identify NONE)
set(CL_AS_LIBRARY TRUE)
include(${Q_CORE})
if(DEFINED DEVKITPRO)
  set(_DKP 1)
else()
  set(_DKP 0)
endif()
string(REPLACE \";\" \"|\" _FIND_ROOT \"\${CMAKE_FIND_ROOT_PATH}\")
")
  file(APPEND "${DIR}/src/CMakeLists.txt" [==[
file(WRITE ]==] "${Q_RESULT}" [==[

  "system=${CMAKE_SYSTEM_NAME}\n"
  "arch=${CMAKE_SYSTEM_PROCESSOR}\n"
  "cross=${CMAKE_CROSSCOMPILING}\n"
  "pm=${CATALOG_PACKAGE_MANAGER}\n"
  "devkitpro=${_DKP}\n"
  "install_prefix=${CMAKE_INSTALL_PREFIX}\n"
  "install_default=${CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT}\n"
  "staging=${CMAKE_STAGING_PREFIX}\n"
  "find_root=${_FIND_ROOT}\n"
  "sysroot=${CMAKE_SYSROOT}\n")
]==])

  execute_process(
    COMMAND "${CMAKE_COMMAND}" -S "${DIR}/src" -B "${DIR}/build" ${CL_COMMON_ARGS}
    RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE OUT
  )
  if(NOT RC EQUAL 0)
    file(REMOVE_RECURSE "${DIR}")
    _cl_die("could not evaluate the toolchain:\n${OUT}")
  endif()

  _cl_kv_parse("${DIR}/result.txt" ID)
  file(REMOVE_RECURSE "${DIR}")

  string(TOLOWER "${ID_system}" SYSTEM)
  string(TOLOWER "${ID_arch}" ARCH)
  if(ARCH MATCHES "^(x86_64|amd64)$")
    set(ARCH "x86_64")
  elseif(ARCH MATCHES "^(aarch64|arm64)$")
    set(ARCH "aarch64")
  elseif(ARCH MATCHES "^i[3-6]86$")
    set(ARCH "x86")
  endif()
  if(ARCH STREQUAL "")
    set(ARCH "unknown")
  endif()

  set(CL_SYSTEM "${SYSTEM}" PARENT_SCOPE)
  set(CL_ARCH "${ARCH}" PARENT_SCOPE)
  set(CL_CROSS "${ID_cross}" PARENT_SCOPE)
  set(CL_HOST_PM "${ID_pm}" PARENT_SCOPE)
  set(CL_DEVKITPRO "${ID_devkitpro}" PARENT_SCOPE)
  set(CL_ID_INSTALL_PREFIX "${ID_install_prefix}" PARENT_SCOPE)
  set(CL_ID_INSTALL_DEFAULT "${ID_install_default}" PARENT_SCOPE)
  set(CL_ID_STAGING "${ID_staging}" PARENT_SCOPE)
  set(CL_ID_FIND_ROOT "${ID_find_root}" PARENT_SCOPE)
  set(CL_ID_SYSROOT "${ID_sysroot}" PARENT_SCOPE)
endfunction()

function(_cl_default_prefix PREFIX_VAR ORIGIN_VAR)
  set(P "")
  set(O "")
  if(CL_CROSS)
    if(NOT "${CL_ID_STAGING}" STREQUAL "")
      set(P "${CL_ID_STAGING}")
      set(O "toolchain: CMAKE_STAGING_PREFIX")
    elseif(NOT CL_ID_INSTALL_DEFAULT AND NOT "${CL_ID_INSTALL_PREFIX}" STREQUAL "")
      set(P "${CL_ID_INSTALL_PREFIX}")
      set(O "toolchain: CMAKE_INSTALL_PREFIX")
    elseif(NOT "${CL_ID_FIND_ROOT}" STREQUAL "")
      string(REPLACE "|" ";" ROOTS "${CL_ID_FIND_ROOT}")
      list(GET ROOTS 0 P)
      set(O "toolchain: CMAKE_FIND_ROOT_PATH")
    elseif(NOT "${CL_ID_SYSROOT}" STREQUAL "")
      set(P "${CL_ID_SYSROOT}/usr")
      set(O "toolchain: CMAKE_SYSROOT")
    endif()

    if(NOT "${P}" STREQUAL "")
      string(REGEX REPLACE "/+$" "" P_CLEAN "${P}")
      if(P_CLEAN STREQUAL "" OR P_CLEAN STREQUAL "/usr" OR P_CLEAN STREQUAL "/usr/local")
        _cl_warn("the toolchain points at '${P}', which is a host location; not using it as the default prefix (pass --prefix to override)")
        set(P "")
        set(O "")
      endif()
    endif()
  elseif(NOT CMAKE_HOST_WIN32 AND NOT "${CL_ID_INSTALL_PREFIX}" STREQUAL "")
    set(P "${CL_ID_INSTALL_PREFIX}")
    set(O "system default")
  endif()

  if(NOT "${P}" STREQUAL "")
    file(TO_CMAKE_PATH "${P}" P)
  endif()
  set(${PREFIX_VAR} "${P}" PARENT_SCOPE)
  set(${ORIGIN_VAR} "${O}" PARENT_SCOPE)
endfunction()

function(_cl_setup_target)
  _cl_home(HOME)

  set(TOOLCHAIN "")
  if(NOT "${CL_OPT_TOOLCHAIN}" STREQUAL "")
    set(TOOLCHAIN "${CL_OPT_TOOLCHAIN}")
  elseif(DEFINED ENV{CMAKE_TOOLCHAIN_FILE} AND NOT "$ENV{CMAKE_TOOLCHAIN_FILE}" STREQUAL "")
    set(TOOLCHAIN "$ENV{CMAKE_TOOLCHAIN_FILE}")
  endif()
  if(NOT "${TOOLCHAIN}" STREQUAL "")
    if(NOT EXISTS "${TOOLCHAIN}")
      _cl_die("toolchain file not found: ${TOOLCHAIN}")
    endif()
    file(REAL_PATH "${TOOLCHAIN}" TOOLCHAIN BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}")
  endif()

  set(GEN_ARGS "")
  if(NOT DEFINED ENV{CMAKE_GENERATOR})
    find_program(_CL_NINJA NAMES ninja ninja-build)
    if(_CL_NINJA)
      set(GEN_ARGS -G Ninja)
    endif()
  endif()
  set(FORWARD_ARGS "")
  if(NOT "${TOOLCHAIN}" STREQUAL "")
    list(APPEND FORWARD_ARGS "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN}")
  endif()
  foreach(DEF ${CL_OPT_DEFINES})
    if(NOT DEF MATCHES "^[A-Za-z_][A-Za-z0-9_]*(:[A-Za-z]+)?=")
      _cl_die("invalid -D argument '${DEF}' (expected NAME=VALUE)")
    endif()
    list(APPEND FORWARD_ARGS "-D${DEF}")
  endforeach()

  set(CL_HOME "${HOME}")
  set(CL_COMMON_ARGS ${GEN_ARGS} ${FORWARD_ARGS})
  file(MAKE_DIRECTORY "${HOME}/work")
  _cl_identify()

  set(ID "${CL_SYSTEM}-${CL_ARCH}")
  if(NOT "${TOOLCHAIN}" STREQUAL "")
    get_filename_component(TC_NAME "${TOOLCHAIN}" NAME_WLE)
    string(REGEX REPLACE "[^A-Za-z0-9_.+-]" "_" TC_NAME "${TC_NAME}")
    set(ID "${ID}-${TC_NAME}")
  elseif(CL_CROSS)
    set(ID "${ID}-cross")
  endif()
  if(NOT "${CL_OPT_TARGET}" STREQUAL "")
    if(NOT CL_OPT_TARGET MATCHES "^[A-Za-z0-9_.+-]+$")
      _cl_die("invalid --target name '${CL_OPT_TARGET}'")
    endif()
    set(ID "${CL_OPT_TARGET}")
  endif()

  if(NOT "${CL_OPT_PREFIX}" STREQUAL "")
    get_filename_component(PREFIX "${CL_OPT_PREFIX}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set(PREFIX_ORIGIN "--prefix")
  else()
    _cl_default_prefix(PREFIX PREFIX_ORIGIN)
    if("${PREFIX}" STREQUAL "")
      set(PREFIX "${HOME}/targets/${ID}")
      set(PREFIX_ORIGIN "Catalog-owned (no system location for this target)")
    endif()
  endif()

  set(WORK "${HOME}/work/${ID}")
  set(CACHE_PATH "${HOME}/cache/${ID}")
  file(MAKE_DIRECTORY "${WORK}" "${CACHE_PATH}")

  file(WRITE "${WORK}/prefix-paths.cmake" "list(PREPEND CMAKE_PREFIX_PATH \"${PREFIX}\")
if(CMAKE_CROSSCOMPILING)
  list(APPEND CMAKE_FIND_ROOT_PATH \"${PREFIX}\")
endif()
")
  list(APPEND FORWARD_ARGS "-DCMAKE_PROJECT_INCLUDE=${WORK}/prefix-paths.cmake")

  set(CL_FORWARD_ARGS "${FORWARD_ARGS}" PARENT_SCOPE)
  set(CL_COMMON_ARGS ${GEN_ARGS} ${FORWARD_ARGS})
  set(CL_COMMON_ARGS "${CL_COMMON_ARGS}" PARENT_SCOPE)
  set(CL_HOME "${HOME}" PARENT_SCOPE)
  set(CL_TOOLCHAIN "${TOOLCHAIN}" PARENT_SCOPE)
  set(CL_TARGET_ID "${ID}" PARENT_SCOPE)
  set(CL_PREFIX "${PREFIX}" PARENT_SCOPE)
  set(CL_PREFIX_ORIGIN "${PREFIX_ORIGIN}" PARENT_SCOPE)
  set(CL_WORK "${WORK}" PARENT_SCOPE)
  set(CL_CACHE "${CACHE_PATH}" PARENT_SCOPE)
  set(CL_SYSTEM "${CL_SYSTEM}" PARENT_SCOPE)
  set(CL_ARCH "${CL_ARCH}" PARENT_SCOPE)
  set(CL_CROSS "${CL_CROSS}" PARENT_SCOPE)
  set(CL_HOST_PM "${CL_HOST_PM}" PARENT_SCOPE)
  set(CL_DEVKITPRO "${CL_DEVKITPRO}" PARENT_SCOPE)
endfunction()

function(_cl_pkgconfig_dirs OUT)
  set(DIRS "${CL_PREFIX}/lib/pkgconfig" "${CL_PREFIX}/lib64/pkgconfig" "${CL_PREFIX}/share/pkgconfig")
  file(GLOB MULTIARCH LIST_DIRECTORIES true "${CL_PREFIX}/lib/*/pkgconfig" "${CL_PREFIX}/lib64/*/pkgconfig")
  list(APPEND DIRS ${MULTIARCH})
  set(${OUT} "${DIRS}" PARENT_SCOPE)
endfunction()

function(_cl_apply_env)
  _cl_pkgconfig_dirs(DIRS)
  if(CMAKE_HOST_WIN32)
    set(SEP ";")
  else()
    set(SEP ":")
  endif()
  string(JOIN "${SEP}" OURS ${DIRS})

  if(CL_CROSS AND NOT DEFINED ENV{PKG_CONFIG_LIBDIR})
    set(ENV{PKG_CONFIG_LIBDIR} "${OURS}")
    set(ENV{PKG_CONFIG_PATH} "${OURS}")
  else()
    if(DEFINED ENV{PKG_CONFIG_PATH} AND NOT "$ENV{PKG_CONFIG_PATH}" STREQUAL "")
      set(ENV{PKG_CONFIG_PATH} "${OURS}${SEP}$ENV{PKG_CONFIG_PATH}")
    else()
      set(ENV{PKG_CONFIG_PATH} "${OURS}")
    endif()
  endif()
endfunction()

function(_cl_probe KIND NAME RP)
  cmake_parse_arguments(P "STREAM" "SPEC;TYPE;SOURCE;STAGE_DIR" "" ${ARGN})
  _cl_apply_env()

  string(RANDOM LENGTH 6 ALPHABET "0123456789abcdef" RND)
  set(DIR "${CL_WORK}/probe-${KIND}-${NAME}-${RND}")
  file(MAKE_DIRECTORY "${DIR}/src")
  set(RESULT "${DIR}/result.txt")
  _cl_cmake_quote("${CL_CORE_FILE}" Q_CORE)
  _cl_cmake_quote("${CL_CACHE}" Q_CACHE)
  _cl_cmake_quote("${RESULT}" Q_RESULT)

  set(T "cmake_minimum_required(VERSION 3.25)\n")
  if(KIND STREQUAL "package")
    string(APPEND T "project(catalog_probe NONE)\n")
  else()
    string(APPEND T "project(catalog_probe LANGUAGES C)\nenable_language(CXX OPTIONAL)\n")
  endif()
  string(APPEND T "set(CL_AS_LIBRARY TRUE)\ninclude(${Q_CORE})\nset(CATALOG_CACHE_DIR ${Q_CACHE})\n")

  if(NOT CL_OPT_NO_DEFAULT_REPO)
    string(APPEND T "cl_repo()\n")
  endif()
  foreach(R ${CL_OPT_REPOS})
    _cl_absolutize_local("${R}" R)
    _cl_cmake_quote("${R}" Q)
    string(APPEND T "cl_repo(${Q})\n")
  endforeach()
  foreach(R ${CL_OPT_RECIPES})
    if(NOT R MATCHES "^([A-Za-z0-9_.+:-]+)=(.+)$")
      _cl_die("invalid --recipe '${R}' (expected NAME=SOURCE)")
    endif()
    set(RN "${CMAKE_MATCH_1}")
    set(RS "${CMAKE_MATCH_2}")
    _cl_absolutize_local("${RS}" RS)
    _cl_cmake_quote("${RS}" Q)
    string(APPEND T "cl_add_recipe(${RN} ${Q})\n")
  endforeach()

  if(CL_OPT_REFRESH)
    string(APPEND T "set(CATALOG_REFRESH_${NAME} TRUE)\n")
  endif()
  if(NOT "${CL_OPT_BUILD_TYPE}" STREQUAL "")
    string(APPEND T "set(CATALOG_BUILD_TYPE \"${CL_OPT_BUILD_TYPE}\")\n")
  endif()

  if(KIND STREQUAL "detect")
    string(APPEND T "set(CATALOG_${NAME}_STAGES \"toolchain;system\")\n")
  elseif(KIND STREQUAL "package")
    string(APPEND T "set(CATALOG_${NAME}_STAGES \"package\")\n")
    string(APPEND T "function(_catalog_prompt_install PACKAGE_NAME)
  _catalog_get_var(\"PACKAGE_MANAGER\" _pm ENV)
  _catalog_get_var(\"PACKAGE_NAME\" _pn)
  file(WRITE ${Q_RESULT} \"state=queried\\npm=\${_pm}\\nname=\${_pn}\\n\")
  set(_CATALOG_FAILED_PACKAGE_STAGE TRUE PARENT_SCOPE)
endfunction()
")
  elseif(KIND STREQUAL "source")
    string(APPEND T "set(CATALOG_${NAME}_STAGES \"source\")\n")
    _cl_cmake_quote("${CL_PREFIX}" Q_PREFIX)
    _cl_cmake_quote("${DIR}/installed-files.txt" Q_LOG)
    _cl_cmake_quote("${CL_FORWARD_ARGS}" Q_FWD)
    string(APPEND T "set(CATALOG_INSTALL_PREFIX ${Q_PREFIX})\nset(CATALOG_INSTALL_LOG ${Q_LOG})\n")
    string(APPEND T "set(CATALOG_INSTALL_CMAKE_ARGS ${Q_FWD})\n")
    if(NOT "${P_STAGE_DIR}" STREQUAL "")
      _cl_cmake_quote("${P_STAGE_DIR}" Q_STAGE)
      string(APPEND T "set(CATALOG_INSTALL_DESTDIR ${Q_STAGE})\n")
    endif()
  else()
    _cl_die("internal error: unknown probe kind '${KIND}'")
  endif()

  set(DEP_ARGS "")
  if(NOT "${P_SPEC}" STREQUAL "")
    set(DEP_ARGS "VERSION \"${P_SPEC}\"")
  endif()
  if(NOT "${P_TYPE}" STREQUAL "")
    set(DEP_ARGS "${DEP_ARGS} ${P_TYPE}")
  endif()
  if("${P_SOURCE}" STREQUAL "")
    set(P_SOURCE "${NAME}")
  endif()
  _cl_cmake_quote("${P_SOURCE}" Q_SOURCE)
  string(APPEND T "cl_add_dependency(${Q_SOURCE} ${DEP_ARGS})\n")
  string(APPEND T "if(TARGET \"deps::${NAME}\")
  get_target_property(_t \"deps::${NAME}\" ALIASED_TARGET)
  file(WRITE ${Q_RESULT} \"state=resolved\\ntarget=\${_t}\\n\")
endif()
")
  file(WRITE "${DIR}/src/CMakeLists.txt" "${T}")

  _cl_verbose("running ${KIND} probe for ${NAME}")
  if(P_STREAM)
    execute_process(
      COMMAND "${CMAKE_COMMAND}" -S "${DIR}/src" -B "${DIR}/build" ${CL_COMMON_ARGS}
      RESULT_VARIABLE RC
    )
    set(OUT "")
  else()
    execute_process(
      COMMAND "${CMAKE_COMMAND}" -S "${DIR}/src" -B "${DIR}/build" ${CL_COMMON_ARGS}
      RESULT_VARIABLE RC OUTPUT_VARIABLE OUT ERROR_VARIABLE OUT
    )
    if(CL_VERBOSE)
      message(NOTICE "${OUT}")
    endif()
  endif()

  set(CLASS "ok")
  if(NOT RC EQUAL 0)
    if(OUT MATCHES "Failed to resolve dependency")
      set(CLASS "notfound")
    elseif(OUT MATCHES "Recipe not found|No recipes or repositories loaded")
      set(CLASS "norecipe")
    elseif(OUT MATCHES "No CMAKE_C_COMPILER could be found")
      set(CLASS "nocompiler")
    else()
      set(CLASS "error")
    endif()
  endif()

  set(STAGE "")
  if(OUT MATCHES "resolved via (toolchain|system)")
    set(STAGE "${CMAKE_MATCH_1}")
  endif()

  foreach(K state target pm name)
    set(_probe_${K} "")
  endforeach()
  _cl_kv_parse("${RESULT}" _probe)
  foreach(K state target pm name)
    set(${RP}_${K} "${_probe_${K}}" PARENT_SCOPE)
  endforeach()

  set(FILES "")
  if(KIND STREQUAL "source" AND EXISTS "${DIR}/installed-files.txt")
    file(STRINGS "${DIR}/installed-files.txt" FILES)
    list(FILTER FILES EXCLUDE REGEX "^$")
  endif()
  set(${RP}_files "${FILES}" PARENT_SCOPE)

  if(NOT CL_VERBOSE)
    file(REMOVE_RECURSE "${DIR}")
  endif()

  set(${RP}_RC "${RC}" PARENT_SCOPE)
  set(${RP}_OUT "${OUT}" PARENT_SCOPE)
  set(${RP}_CLASS "${CLASS}" PARENT_SCOPE)
  set(${RP}_stage "${STAGE}" PARENT_SCOPE)
endfunction()
